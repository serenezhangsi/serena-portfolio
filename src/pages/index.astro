<script is:inline>
(function(){
  var lb=document.getElementById('lb'),im=document.getElementById('lbimg'),last=null;
  document.querySelectorAll('.cert button, .ev button, .vl figure button').forEach(function(b){b.addEventListener('click',function(){last=b;im.src=b.getAttribute('data-src');im.alt=b.querySelector('img').alt;lb.classList.add('on');document.getElementById('lbx').focus();})});
  function close(){lb.classList.remove('on');if(last)last.focus();}
  document.getElementById('lbx').addEventListener('click',close);
  lb.addEventListener('click',function(e){if(e.target===lb)close()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&lb.classList.contains('on'))close()});
})();
</script>

