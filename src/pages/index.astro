---
import Base from '../layouts/Base.astro';
---
<Base title="Serena Zhang · Product Designer" description="Product designer with 10+ years at Tencent: product logic, UI/UX, data and monetization. MS in UX Design at Wilfrid Laurier University.">
<style is:global>
/* Portfolio home: the editorial system of the case studies, in a dark theme. Each case keeps its own accent (blue, orange, teal) so the cards preview the pages they open. */
:root{
  --paper:#0F1013; --surface:#17191E; --ink:#EEF0F3; --muted:#9A9EA8; --line:#262931; --on-ink:#0F1013;
  --signal:#8FA8FF; --soft:#1A2140;
  --c1:#7D97FF; --c2:#FF8A1F; --c3:#3FD3C4;
  --display:"TencentSans","Helvetica Neue",Arial,sans-serif;
  --body:"TencentSans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --mono:"TencentSans","Helvetica Neue",Arial,sans-serif;
  --wrap:1160px; color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:64px}
body{background:var(--paper);color:var(--ink);font:400 16px/1.65 var(--body);margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:24px}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.01em;line-height:1.15;margin:0;text-wrap:balance}
h2{font-size:clamp(24px,2.6vw,30px)}
h3{font-size:18px;letter-spacing:0}
p{margin:0;max-width:62ch}
.eyebrow{font:500 12px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--signal)}
.lede{font-size:16px;color:var(--muted)}
section{padding-block:88px}
.head{display:grid;gap:10px;margin-bottom:32px;max-width:760px}
.cap{font:400 12px/1.5 var(--mono);color:var(--muted)}
figure{margin:0}
:focus-visible{outline:2px solid var(--signal);outline-offset:3px}

.bar{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:14px;font:500 13px var(--mono)}
.bar a{text-decoration:none;color:var(--muted)}
.bar a:hover{color:var(--ink)}
.bar .me{color:var(--ink);font-weight:600}
.bar nav{display:flex;gap:22px}

/* hero */
.hero{padding-block:72px 80px}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:64px;align-items:center}
.hero h1{font-size:clamp(32px,4vw,46px);font-weight:700;letter-spacing:-.015em;margin-block:16px 16px}
.hero h1 em{font-style:normal;color:var(--signal)}
.hi{font:400 15px var(--body);color:var(--muted)}
.hi b{color:var(--ink);font-weight:600}
.ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 20px;border-radius:99px;background:var(--ink);color:var(--on-ink);font-weight:600;text-decoration:none;transition:background .2s}
.btn:hover{background:var(--signal);color:var(--on-ink)}
.btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink)}
.btn.ghost:hover{background:var(--ink);color:var(--on-ink)}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:44px;padding-top:24px;border-top:1px solid var(--line)}
.stats b{display:block;font:800 30px/1 var(--display);letter-spacing:-.03em}
.stats span{display:block;font-size:13px;color:var(--muted);margin-top:8px;line-height:1.4}
.photo{position:relative}
.photo .frame{border-radius:28px;overflow:hidden;background:#EDEBE7;box-shadow:0 0 0 1px var(--line),0 50px 90px -40px #000}
.photo .frame img{width:100%}
.badge{position:absolute;z-index:2;display:flex;align-items:center;gap:10px;padding:9px 18px 9px 10px;border-radius:999px;font-size:12.5px;line-height:1.25;color:#fff;
  background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.04) 60%),rgba(16,17,21,.34);
  -webkit-backdrop-filter:blur(14px) saturate(150%);backdrop-filter:blur(14px) saturate(150%);
  border:1px solid rgba(255,255,255,.38);box-shadow:inset 0 1px 0 rgba(255,255,255,.45),inset 0 -8px 16px rgba(255,255,255,.06),0 18px 40px -18px rgba(0,0,0,.6);
  animation:bob 6s ease-in-out infinite}
.badge b{display:block;font:700 13.5px var(--display);text-shadow:0 1px 6px rgba(0,0,0,.35)}
.badge small{color:rgba(255,255,255,.82);text-shadow:0 1px 6px rgba(0,0,0,.35)}
.badge i{width:26px;height:26px;border-radius:50%;flex:none}
.badge.a{left:-48px;bottom:7%}
.badge.a i{background:radial-gradient(circle at 35% 30%,#777 0,#111 65%);box-shadow:0 2px 6px rgba(0,0,0,.4)}
.badge.b{right:-44px;top:4%;animation-duration:7s;animation-delay:-3s}
.badge.b i{background:radial-gradient(circle at 35% 30%,#fff 0,#D6D6D6 70%);box-shadow:0 2px 6px rgba(0,0,0,.25)}
@keyframes bob{0%,100%{transform:translate(0,0)}35%{transform:translate(4px,-10px)}70%{transform:translate(-3px,-4px)}}

/* what I bring */
.bring{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:40px;align-items:start}
.pts{list-style:none;margin:0;padding:0;display:grid;gap:26px}
.pts li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:16px;align-items:start}
.pts .n{font:700 40px/1 var(--display);color:var(--signal)}
.pts h3{font-size:19px;margin-bottom:6px}
.pts p{color:var(--muted);font-size:15px}
.ev{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:12px;align-items:start}
.ev figure{display:grid;gap:6px;align-content:start}
.ev img{width:100%;border-radius:12px;background:#fff}
.ev figcaption{font-size:12px;color:var(--muted)}
.src{margin-top:18px}
@media (max-width:900px){.bring{grid-template-columns:1fr}}
@media (max-width:520px){.ev{grid-template-columns:1fr}}

/* work */
.work{display:grid;gap:28px}
.case{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);border-radius:28px;overflow:hidden;background:var(--surface);box-shadow:0 0 0 1px var(--line);text-decoration:none;color:var(--ink);transition:box-shadow .25s,transform .25s}
.case:hover{box-shadow:0 0 0 2px var(--k),0 40px 80px -40px #000;transform:translateY(-2px)}
.case .txt{padding:40px;display:grid;gap:16px;align-content:start}
.case .no{font:600 12px var(--mono);letter-spacing:.14em;color:var(--k)}
.case h3{font-size:22px;font-weight:700;letter-spacing:-.01em}
.case .meta{font:500 12.5px var(--mono);color:var(--muted)}
.case p{color:var(--muted);font-size:15.5px}
.case .ms{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding-top:18px;border-top:1px solid var(--line);margin-top:4px}
.case .ms b{display:block;font:700 22px/1 var(--display);letter-spacing:-.03em;color:var(--ink)}
.case .ms span{display:block;font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.35}
.case .go{font:600 14px var(--body);color:var(--k);display:flex;align-items:center;gap:8px;margin-top:6px}
.case .go i{font-style:normal;transition:transform .2s}
.case:hover .go i{transform:translateX(4px)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font:500 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);border-radius:99px;padding:5px 10px;color:var(--muted);background:var(--paper)}
.vis{position:relative;min-height:380px;overflow:hidden}
.v1{background:#0A0C14}
.v1{background:radial-gradient(circle at 70% 25%,#1B2A5E 0,#10162E 55%,#0A0C14)}
.v1 .br{position:absolute;left:6%;top:12%;width:88%;border-radius:12px;overflow:hidden;background:#1c1c1c;box-shadow:0 30px 60px -20px #000}
.v1 .br .chrome{display:flex;gap:5px;padding:8px 10px;background:#2a2a2e}
.v1 .br .chrome i{width:8px;height:8px;border-radius:50%;background:#55565c}
.v1 .ph{position:absolute;right:4%;bottom:-8%;width:27%;border-radius:16px;overflow:hidden;box-shadow:0 0 0 4px #0f1013,0 30px 50px -16px #000}
.v1 .glow{position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,#2B5CFF55,transparent 55%)}
.v2{background:radial-gradient(circle at 70% 30%,#4A2A10 0,#24180F 60%,#1C150F)}
.v2 .br{position:absolute;left:8%;top:12%;width:86%;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 30px 60px -20px #000}
.v2 .br .chrome{display:flex;gap:5px;padding:8px 10px;background:#F1EEE9}
.v2 .br .chrome i{width:8px;height:8px;border-radius:50%;background:#D8D2C9}
.v2 .ph{position:absolute;right:5%;bottom:-6%;width:30%;border-radius:14px;overflow:hidden;box-shadow:0 30px 50px -16px #000}
.v3{background:radial-gradient(circle at 50% 60%,#14423D 0,#10302D 50%,#0D2321 85%)}
.v3 .p{position:absolute;width:34%;border-radius:20px;overflow:hidden;box-shadow:0 0 0 5px #24302E,0 0 0 6px #33403E,0 30px 60px -24px #000}
.v3 .p.a{left:16%;top:10%;transform:rotate(-5deg)}
.v3 .p.b{right:14%;top:18%;transform:rotate(5deg)}

/* competitions */
.comps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.comp{background:var(--surface);border-radius:24px;overflow:hidden;box-shadow:0 0 0 1px var(--line);display:grid;grid-template-rows:auto 1fr}
.comp .ph{position:relative;aspect-ratio:4/3;overflow:hidden;background:#22252B}
.comp .ph img{width:100%;height:100%;object-fit:cover}
.place{position:absolute;left:14px;top:14px;font:700 13px var(--display);padding:7px 12px;border-radius:99px;background:#1B1C1E;color:#fff;letter-spacing:-.01em;box-shadow:0 6px 16px -6px #000}
.place.gold{background:#F5C451;color:#1B1C1E}
.place.silver{background:#E3E5E8;color:#1B1C1E}
.place.bronze{background:#D9A066;color:#1B1C1E}
.comp .bd{padding:22px 24px 24px;display:grid;gap:10px;align-content:start}
.comp h3{font-size:20px}
.comp .org{font:500 12px var(--mono);color:var(--muted)}
.comp p{font-size:14.5px;color:var(--muted)}
.cert{display:flex;align-items:center;gap:12px;margin-top:8px;padding-top:14px;border-top:1px dashed var(--line);font:500 12px var(--mono);color:var(--muted)}
.cert button{padding:0;border:0;background:none;cursor:zoom-in;border-radius:6px;overflow:hidden;box-shadow:0 0 0 1px var(--line);flex:none}
.cert img{width:72px}


/* campus / ISL */
.isl{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:48px;align-items:center}
.isl > *{min-width:0}
.isl-txt{display:grid;gap:16px}
.isl-txt .role{display:flex;flex-wrap:wrap;gap:8px}
.isl-txt ul{margin:0;padding-left:18px;display:grid;gap:8px;color:var(--muted);font-size:15.5px}
.isl-txt ul b{color:var(--ink);font-weight:600}
.isl-q{margin:6px 0 0;padding:18px 22px;border-radius:18px;background:var(--surface);box-shadow:0 0 0 1px var(--line);font:500 16.5px/1.55 var(--display);letter-spacing:-.005em}
.isl-q small{display:block;margin-top:10px;font:500 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.isl-link{font:600 14px var(--body);color:var(--signal);text-decoration:none}
.isl-link:hover{text-decoration:underline}
.isl-media{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:14px;align-items:stretch}
.vid{position:relative;border-radius:26px;overflow:hidden;background:#000;box-shadow:0 0 0 1px var(--line),0 40px 80px -40px #000;aspect-ratio:9/16}
.vid video{width:100%;height:100%;object-fit:cover;display:block}
.vid .tag-v{position:absolute;left:12px;top:12px;z-index:1;font:600 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#fff;padding:6px 10px;border-radius:99px;background:rgba(16,17,21,.4);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.3);pointer-events:none;transition:opacity .2s}
.vid.playing .tag-v{opacity:0}
.isl-ph{display:grid;grid-template-rows:1fr 1fr;gap:14px}
.isl-ph figure{border-radius:20px;overflow:hidden;background:#22252B;position:relative}
.isl-ph img{width:100%;height:100%;object-fit:cover}
.isl-ph figcaption{position:absolute;left:12px;bottom:12px;font:500 11.5px var(--mono);color:#fff;padding:5px 10px;border-radius:99px;background:rgba(16,17,21,.45);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}

/* beyond work */
.hob{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:48px;align-items:center;padding-block:40px;border-top:1px solid var(--line)}
.hob:first-of-type,.head + .hob{border-top:0;padding-top:0}
.hob.flip{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)}
.hob.flip .ht{order:2}
.ht{display:grid;gap:14px}
.ht .big{font:700 36px/1 var(--display);letter-spacing:-.02em}
.ht .big small{font-size:.4em;letter-spacing:0;margin-left:6px;color:var(--muted);font-weight:600}
.ht h3{font-size:20px}
.ht p{color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font:600 12.5px var(--body);padding:7px 12px;border-radius:99px;background:var(--surface);box-shadow:0 0 0 1px var(--line)}
.chip.dk{background:var(--ink);color:var(--on-ink);box-shadow:none}
.mos{display:grid;grid-template-columns:1.3fr 1fr;grid-template-rows:1fr 1fr;gap:12px;height:440px}
.mos figure{border-radius:18px;overflow:hidden;background:#22252B}
.mos img{width:100%;height:100%;object-fit:cover}
.mos .tall{grid-row:span 2}
.mos.fr{grid-template-columns:1fr 1.3fr}
.mos.fr .tall{grid-column:1;grid-row:1 / span 2}
.yoga{margin-top:8px;display:flex;align-items:center;gap:14px;padding:18px 22px;border-radius:18px;background:var(--surface);box-shadow:0 0 0 1px var(--line);font-size:15px;color:var(--muted)}
.yoga b{color:var(--ink)}

/* resume */
.cv{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);gap:56px}
.cv > *{min-width:0}
.job{display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px;padding-block:28px;border-top:1px solid var(--line)}
.job:first-child{border-top:2px solid var(--ink)}
.job .when{font:500 12.5px/1.5 var(--mono);color:var(--muted)}
.job .when b{display:block;color:var(--ink);font-weight:600}
.job h3{font-size:21px}
.job .co{font-size:14.5px;color:var(--muted);margin-top:4px}
.job ul{margin:14px 0 0;padding-left:18px;display:grid;gap:8px;font-size:15px;color:var(--muted)}
.job li b{color:var(--ink);font-weight:600}
.job .prod{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--signal);margin-top:14px}
.side{display:grid;gap:32px;align-content:start}
.blk{border-top:2px solid var(--ink);padding-top:18px;display:grid;gap:14px}
.blk h4{margin:0;font:500 12px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.edu b{display:block;font:700 16px var(--display)}
.edu span{display:block;font-size:14px;color:var(--muted)}
.edu small{font:500 12px var(--mono);color:var(--muted)}
.blk ul{margin:0;padding-left:18px;display:grid;gap:8px;font-size:14.5px;color:var(--muted)}
.lang{display:grid;gap:10px}
.lang div{display:grid;grid-template-columns:1fr auto;font-size:14.5px}
.lang span{font:500 12px var(--mono);color:var(--muted)}

/* contact */
.contact{background:var(--surface);color:#fff;box-shadow:0 0 0 1px var(--line);border-radius:28px;margin:0 12px 12px;padding:72px 0}
.contact .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:48px;align-items:end}
.contact h2{font-size:clamp(26px,3vw,36px);font-weight:700;letter-spacing:-.01em}
.contact h2 em{font-style:normal;color:#8FA8FF}
.contact .eyebrow{color:#8FA8FF}
.links{display:grid;gap:4px}
.links a,.links div{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid #ffffff22;text-decoration:none;font-size:16px}
.links span{font:500 12px var(--mono);color:#ffffff88;letter-spacing:.1em;text-transform:uppercase;padding-top:3px}
.links a:hover{color:#8FA8FF}
.foot{font:400 12px var(--mono);color:#ffffff77;margin-top:56px}

/* lightbox */
.lb{position:fixed;inset:0;z-index:20;background:#111214EE;display:none;place-items:center;padding:24px}
.lb.on{display:grid}
.lb img{max-height:88vh;max-width:min(1100px,94vw);border-radius:10px}
.lb button{position:fixed;top:14px;right:16px;font:600 13px var(--mono);border:0;border-radius:99px;padding:9px 16px;background:#fff;color:#111;cursor:pointer}

@media (max-width:900px){
  section{padding-block:72px}
  .bar nav{gap:14px}.bar nav a.opt{display:none}
  .hero .wrap,.case,.hob,.hob.flip,.cv,.contact .wrap{grid-template-columns:1fr}
  .hero .wrap{gap:40px}
  .photo{max-width:420px}
  .badge.a{left:-8px}.badge.b{right:-8px}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .case .txt{padding:28px}
  .vis{min-height:300px;order:-1}
  .comps{grid-template-columns:1fr}
  .isl{grid-template-columns:1fr}
  .hob.flip .ht{order:0}
  .mos{height:340px}
  .job{grid-template-columns:1fr;gap:8px}
}
@media (max-width:520px){.case .ms{grid-template-columns:1fr 1fr}.mos{height:280px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}.badge{animation:none}html{scroll-behavior:auto}}

/* approach: the design loop */
.loop4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;position:relative}
.loop4 > *{min-width:0}
.st{position:relative;background:var(--surface);border-radius:22px;box-shadow:0 0 0 1px var(--line);padding:24px 22px 22px;display:grid;gap:10px;align-content:start}
.st .n{display:flex;align-items:center;justify-content:space-between;font:600 12px var(--mono);letter-spacing:.12em;color:var(--k)}
.st .n i{font-style:normal;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--k) 18%,transparent);color:var(--k);font:700 15px var(--display);letter-spacing:0}
.st h3{font-size:18px}
.st p{font-size:14.5px;color:var(--muted)}
.st .ex{margin-top:6px;padding-top:12px;border-top:1px dashed var(--line);font-size:13.5px;color:var(--ink);line-height:1.45}
.st .ex small{display:block;font:500 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.st .ex a{color:var(--k);text-decoration:none;font-weight:600}
.st .ex a:hover{text-decoration:underline}
.st:not(:last-child)::after{content:"→";position:absolute;right:-13px;top:50%;transform:translateY(-50%);z-index:1;width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font:600 12px var(--mono);color:var(--paper);background:var(--muted)}
.back{margin-top:16px;display:flex;align-items:center;gap:14px;font:500 13px var(--mono);color:var(--muted)}
.back::before,.back::after{content:"";flex:1;height:1px;background:repeating-linear-gradient(90deg,var(--line) 0 6px,transparent 6px 12px)}
.back b{color:var(--ink);font-weight:600}
@media (max-width:900px){.loop4{grid-template-columns:1fr 1fr}.st:nth-child(2)::after{display:none}}
@media (max-width:560px){.loop4{grid-template-columns:1fr}.loop4 .st::after{display:none!important}}

/* laurier work */
.lw{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.lwc{background:var(--surface);border-radius:24px;overflow:hidden;box-shadow:0 0 0 1px var(--line);display:grid;grid-template-rows:auto 1fr;text-decoration:none;color:var(--ink);transition:box-shadow .25s,transform .25s}
.lwc:hover{box-shadow:0 0 0 2px var(--k),0 40px 80px -40px #000;transform:translateY(-2px)}
.lwc .ph{aspect-ratio:4/3;overflow:hidden;background:#22252B}
.lwc .ph img{width:100%;height:100%;object-fit:cover}
.lwc .bd{padding:24px 26px 26px;display:grid;gap:10px;align-content:start}
.lwc .no{font:600 12px var(--mono);letter-spacing:.14em;color:var(--k)}
.lwc h3{font-size:20px;font-weight:700;letter-spacing:-.01em}
.lwc .org{font:500 12.5px var(--mono);color:var(--muted)}
.lwc p{font-size:15px;color:var(--muted)}
.lwc .go{font:600 14px var(--body);color:var(--k);display:flex;align-items:center;gap:8px;margin-top:4px}
.lwc .go i{font-style:normal;transition:transform .2s}
.lwc:hover .go i{transform:translateX(4px)}
@media (max-width:800px){.lw{grid-template-columns:1fr}}
