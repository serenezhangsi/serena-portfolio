---
import Base from '../layouts/Base.astro';
---
<Base title="Serena Zhang · Product Designer" description="Product designer with 10+ years at Tencent: product logic, UI/UX, data and monetization. MS in UX Design at Wilfrid Laurier University.">
<style is:global>
/* Portfolio home in a Tailscale-like rhythm: plain white and near-black bands alternate, one idea per band, neutral type, black buttons, thin-bordered cards. Colour only lives inside image panels. */
:root{
  --paper:#F4EFE6; --soft:#EDE7DB; --ink:#1E2026; --muted:#6A6B70; --line:#DED6C7; --card:#FAF7F1;
  --dark:#0D1424; --dark2:#141C30; --dline:#243049; --dink:#EEF0F3; --dmuted:#9A9EA8;
  --blue:#4C6FFF; --t-blue:#E9EDFF; --t-orange:#FFEBDB; --t-teal:#DDF3EF; --t-violet:#ECE7FF; --t-red:#F8E3DF;
  --font:"TencentSans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --wrap:1120px; color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:64px}
body{background:var(--paper);color:var(--ink);font:400 16px/1.6 var(--font);margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
img{max-width:100%;display:block}
a{color:inherit}
h1,h2,h3{font-family:var(--font);font-weight:700;letter-spacing:-.01em;line-height:1.15;margin:0;text-wrap:balance}
h2{font-size:clamp(26px,3vw,34px)}
h3{font-size:18px}
p{margin:0;max-width:62ch}
figure{margin:0}
:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.kicker{font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.band{padding-block:96px}
.band.dark{background:var(--dark);color:var(--dink)}
.band.dark .kicker,.band.dark .muted{color:var(--dmuted)}
.muted{color:var(--muted)}
.head{display:grid;gap:10px;margin-bottom:40px;max-width:720px}
.head p{color:var(--muted)}
.dark .head p{color:var(--dmuted)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:6px;background:var(--ink);color:var(--paper);font-weight:500;font-size:15px;text-decoration:none;border:1px solid var(--ink)}
.btn:hover{background:#0D1424}
.btn.ghost{background:transparent;color:var(--ink);border-color:#CFCBC8}
.btn.ghost:hover{border-color:var(--ink)}

/* top strip + nav */
.strip{background:#0A101D;color:var(--dmuted);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;text-align:center;padding:9px 16px}
.strip b{color:var(--dink);font-weight:500}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--dark) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--dline);color:var(--dink)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--dark)}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:12px}
.bar .me{font-weight:700;text-decoration:none;font-size:16px}
.bar nav{display:flex;align-items:center;gap:22px;font-size:14.5px}
.bar nav a{text-decoration:none;color:var(--dmuted)}
.bar nav a:hover{color:var(--dink)}
.bar nav .btn{background:var(--dink);border-color:var(--dink);color:var(--dark);padding:8px 14px;font-size:14px}

/* hero */
.hero{padding-block:0;background:var(--dark);color:var(--dink);position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;right:-10%;top:-30%;width:70%;height:140%;background:radial-gradient(closest-side,#22306B88,transparent 70%);pointer-events:none}
.hero .wrap{position:relative}
.hero .kicker{color:var(--dmuted)}
.hero .btn{background:var(--dink);border-color:var(--dink);color:var(--dark)}
.hero .btn.ghost{background:transparent;color:var(--dink);border-color:#3A4660}
.hero .btn.ghost:hover{border-color:var(--dink)}
.hero .facts span{border-color:var(--dline);color:var(--dmuted)}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:24px;align-items:end;min-height:620px}
.hero .wrap > div:first-child{padding-block:96px 104px;align-self:center}
.hero-fig{position:relative;align-self:end;height:600px;margin:0}
.hero-fig svg{position:absolute;left:50%;top:46%;width:118%;height:auto;transform:translate(-50%,-50%) rotate(-8deg);overflow:visible}
.hero-fig img{position:absolute;left:50%;bottom:0;height:96%;width:auto;max-width:none;transform:translateX(-50%);filter:drop-shadow(0 24px 40px #0006)}
.hero h1{font-size:clamp(36px,5vw,58px);margin-block:18px 18px}
.hero .lede{font-size:18px;color:var(--dmuted)}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.facts span{font-size:13px;padding:6px 10px;border:1px solid var(--line);border-radius:6px;color:var(--muted)}
.portrait{border-radius:16px;overflow:hidden;background:var(--soft);border:1px solid var(--dline)}

/* value (dark) */
.vrow{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:72px;align-items:stretch}
.pts{list-style:none;margin:0;padding:0;display:grid;grid-auto-rows:1fr;height:100%;max-width:500px}
.pts li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:8px;align-content:center;padding:22px 0;border-top:1px solid var(--line)}
.pts li:last-child{border-bottom:1px solid var(--line)}
.pts .n{font-size:14px;color:var(--muted);padding-top:5px}
.pts h3{margin:0 0 10px;font-size:20px}
.pts p{color:var(--muted);font-size:17px;line-height:1.65;margin:0;max-width:30em}
.pts p b{color:var(--ink);font-weight:600}
.ev{display:grid;gap:24px;width:400px;align-content:start;justify-self:end}
.ev figure,.vl figure{display:grid;gap:8px;margin:0}
.ev button,.vl figure button{padding:0;border:1px solid var(--line);background:var(--card);border-radius:8px;overflow:hidden;cursor:zoom-in;display:block;width:100%}
.ev img,.vl figure img{width:100%;height:auto;display:block}
.ev figcaption,.vl figcaption{font-size:12.5px;color:var(--muted)}
@media (max-width:960px){.vrow{grid-template-columns:1fr;gap:28px}.pts{grid-auto-rows:auto;max-width:none}.ev{justify-self:start}.ev{width:min(520px,100%)}}
@media (max-width:620px){.ev{width:100%}}
.loop{margin-top:56px;padding-top:40px;border-top:1px solid var(--line)}
.loop h3{font-size:22px;margin-bottom:20px}
.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border:1px solid var(--line);border-radius:12px;overflow:hidden}
.steps div{padding:20px 22px;display:grid;gap:6px;align-content:start}
.steps div + div{border-left:1px solid var(--line)}
.steps small{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.steps b{font-size:17px;font-weight:700}
.steps p{font-size:14px;color:var(--muted)}
.steps a{color:var(--ink)}
.src{margin-top:18px;font-size:12px;color:var(--muted)}

/* work (white) */
.case{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);border:1px solid var(--dline);border-radius:14px;overflow:hidden;text-decoration:none;color:var(--dink);background:var(--dark2);transition:border-color .2s}
.case + .case{margin-top:20px}
.case:hover{border-color:var(--dmuted)}
.case .txt{padding:36px;display:grid;gap:12px;align-content:start}
.case .meta{font-size:13.5px;color:var(--dmuted)}
.case h3{font-size:22px}
.case p{color:var(--dmuted);font-size:15px}
.ms{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding-top:16px;margin-top:4px;border-top:1px solid var(--dline)}
.ms b{display:block;font-size:22px;font-variant-numeric:tabular-nums}
.ms span{display:block;font-size:12.5px;color:var(--dmuted)}
.go{font-size:14.5px;font-weight:500;margin-top:4px}
.vis{position:relative;min-height:360px;overflow:hidden}
.vis .br{position:absolute;left:7%;top:12%;width:86%;border-radius:10px;overflow:hidden;background:#fff;box-shadow:0 20px 40px -24px #0006,0 0 0 1px #0000000f}
.vis .br .chrome{display:flex;gap:5px;padding:7px 10px;background:#EFEDEB}
.vis .br .chrome i{width:8px;height:8px;border-radius:50%;background:#D3CFCB}
.vis .ph{position:absolute;right:5%;bottom:-8%;width:28%;border-radius:14px;overflow:hidden;box-shadow:0 20px 40px -20px #000,0 0 0 4px #0D1424}
.v1{background:radial-gradient(circle at 70% 25%,#1B2A5E 0,#10162E 70%)} .v2{background:radial-gradient(circle at 70% 30%,#4A2A10 0,#24180F 70%)} .v3{background:radial-gradient(circle at 50% 60%,#14423D 0,#0D2321 80%)}
.v3 .p{position:absolute;width:33%;border-radius:16px;overflow:hidden;box-shadow:0 20px 40px -20px #000,0 0 0 4px #24302E}
.v3 .p.a{left:16%;top:10%;transform:rotate(-4deg)}
.v3 .p.b{right:14%;top:18%;transform:rotate(4deg)}
.sub2{margin:64px 0 20px;display:grid;gap:6px}
.sub2 h3{font-size:22px}
.lw{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.lwc{border:1px solid var(--dline);border-radius:14px;overflow:hidden;text-decoration:none;color:var(--dink);background:var(--dark2);display:grid;grid-template-rows:auto 1fr;transition:border-color .2s}
.lwc:hover{border-color:var(--dmuted)}
.lwc .ph{aspect-ratio:4/3;overflow:hidden;background:var(--soft)}
.lwc .ph img{width:100%;height:100%;object-fit:cover}
.lwc .bd{padding:24px;display:grid;gap:8px;align-content:start}
.lwc p{color:var(--dmuted);font-size:15px}

/* awards (dark) */
.comps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.comp{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:grid;grid-template-rows:auto 1fr}
.comp .ph{position:relative;aspect-ratio:4/3;overflow:hidden}
.comp .ph img{width:100%;height:100%;object-fit:cover}
.place{position:absolute;left:12px;top:12px;font-size:13px;font-weight:700;padding:5px 10px;border-radius:6px;background:var(--ink);color:var(--paper)}
.comp .bd{padding:20px 22px;display:grid;gap:6px;align-content:start}
.comp p{font-size:14.5px;color:var(--muted)}
.cert{display:flex;align-items:center;gap:10px;margin-top:8px;font-size:12.5px;color:var(--muted)}
.cert button{border:1px solid var(--line)!important}
.cert button{padding:0;border:0;background:none;cursor:zoom-in;border-radius:4px;overflow:hidden;flex:none}
.cert img{width:64px}
.isl{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;margin-top:56px;padding-top:40px;border-top:1px solid var(--line)}
.isl > *{min-width:0}
.isl ul{margin:12px 0 0;padding-left:18px;display:grid;gap:6px;color:var(--muted);font-size:15px}
.isl ul b{color:var(--ink);font-weight:500}
.isl a.lk{display:inline-block;margin-top:14px;font-size:14.5px;color:var(--ink)}
.isl-media{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:12px}
.vid{border-radius:12px;overflow:hidden;background:#000;aspect-ratio:9/16}
.vid video{width:100%;height:100%;object-fit:cover;display:block}
.isl-ph{display:grid;grid-template-rows:1fr 1fr;gap:12px}
.isl-ph img{width:100%;height:100%;object-fit:cover;border-radius:12px}

/* hobbies (white) */
.hobs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.hob{border:1px solid var(--line);border-radius:14px;overflow:hidden;display:grid;grid-template-rows:auto 1fr}
.hob .ph{aspect-ratio:4/3;overflow:hidden;background:var(--soft)}
.hob .ph img{width:100%;height:100%;object-fit:cover}
.hob .bd{padding:22px;display:grid;gap:6px;align-content:start}
.hob p{color:var(--muted);font-size:15px}
.hob .big{font-size:13px;color:var(--muted)}

/* contact (dark) */
.contact .wrap{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:end}
.contact h2{font-size:clamp(28px,3.4vw,40px)}
.links{display:grid}
.links a,.links div{display:flex;justify-content:space-between;gap:16px;padding:16px 0;border-bottom:1px solid var(--dline);text-decoration:none;font-size:16px}
.links span{font-size:13px;color:var(--dmuted);text-transform:uppercase;letter-spacing:.06em}
.links a:hover{color:#fff}
.foot{padding-block:24px;font-size:12.5px;color:var(--dmuted);background:var(--dark);border-top:1px solid var(--dline)}

/* lightbox */
.lb{position:fixed;inset:0;z-index:20;background:#111214EE;display:none;place-items:center;padding:24px}
.lb.on{display:grid}
.lb img{max-height:88vh;max-width:min(1100px,94vw);border-radius:8px}
.lb button{position:fixed;top:calc(14px + env(safe-area-inset-top,0px));right:16px;font:500 13px var(--font);border:0;border-radius:6px;padding:9px 14px;background:#fff;color:#111;cursor:pointer}

@media (max-width:900px){
  .band{padding-block:72px}
  .bar nav a.opt{display:none}
  .case,.isl,.contact .wrap{grid-template-columns:1fr}
  .hero .wrap{grid-template-columns:1fr;min-height:0;gap:0}
  .hero .wrap > div:first-child{padding-block:48px 8px}
  .hero-fig{height:440px;max-width:420px;width:100%;justify-self:center}
  .comps,.hobs{grid-template-columns:1fr}
  .steps{grid-template-columns:1fr 1fr}
  .steps div:nth-child(3){border-left:0}
  .steps div:nth-child(n+3){border-top:1px solid var(--line)}
  .vis{min-height:280px;order:-1}
  .case .txt{padding:26px}
  .lw{grid-template-columns:1fr}
}
@media (max-width:520px){.steps{grid-template-columns:1fr}.steps div + div{border-left:0;border-top:1px solid var(--line)}.ms{grid-template-columns:1fr 1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}html{scroll-behavior:auto}}
/* ---- palette: deep navy / light grey, teal accents ---- */
:root{
  --paper:#EEEEEE; --soft:#E6E8E9; --card:#F7F8F8; --line:#D6DADC; --ink:#071B2B; --muted:#53606B;
  --dark:#071B2B; --dark2:#0D2738; --dline:#1C3A4D; --dink:#EEF4F5; --dmuted:#9DB4BE;
  --teal:#167D8D; --mint:#B9E4E8;
}
.strip{background:#04121E}
.strip b{color:var(--mint)}
.btn{background:var(--teal);border-color:var(--teal);color:#fff}
.btn:hover{background:#12697A;border-color:#12697A}
.bar nav .btn,.hero .btn{background:var(--mint);border-color:var(--mint);color:var(--dark)}
.bar nav .btn:hover,.hero .btn:hover{background:#fff;border-color:#fff}
.hero .btn.ghost{background:transparent;color:var(--mint);border-color:#2E5568}
.hero .btn.ghost:hover{border-color:var(--mint)}
.hero::before{background:radial-gradient(closest-side,#167D8D66,transparent 70%)}
.kicker{color:var(--teal);font-weight:500}
.hero .kicker,.band.dark .kicker{color:var(--mint)}
.pts .n,.steps small{color:var(--teal);font-weight:600}
.pts p b,.isl ul b{color:var(--teal)}
.steps a,.isl a.lk{color:var(--teal)}
.case:hover,.lwc:hover{border-color:var(--teal)}
.ms b{color:var(--mint)}
.go{color:var(--mint)}
.v1{background:radial-gradient(circle at 70% 25%,#1E5A73 0,#0B2A3B 75%)}
.v2{background:radial-gradient(circle at 70% 30%,#167D8D 0,#0D4E5A 80%)}
.v3{background:radial-gradient(circle at 50% 60%,#5FAFB8 0,#2C7E89 85%)}
.vis .ph{box-shadow:0 20px 40px -20px #000a,0 0 0 4px var(--dark)}
.place{background:var(--teal);color:#fff}
.links a:hover{color:var(--mint)}

/* how I got here */
.contact .wrap.pw{display:block;margin-bottom:88px;padding-bottom:72px;border-bottom:1px solid var(--dline)}
.path{list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;position:relative}
.path::before{content:"";position:absolute;left:6px;right:6px;top:6px;height:2px;background:linear-gradient(90deg,var(--dline),var(--teal))}
.path li{position:relative;padding-top:30px;display:grid;gap:6px;align-content:start}
.path li::before{content:"";position:absolute;left:0;top:0;width:14px;height:14px;border-radius:50%;background:var(--dark);border:2px solid var(--teal)}
.path li.now::before{background:var(--mint);border-color:var(--mint);box-shadow:0 0 0 6px #B9E4E833}
.path .yr{font:500 12px var(--font);letter-spacing:.08em;color:var(--mint)}
.path b{font-size:17px;line-height:1.3;color:var(--dink)}
.path p{font-size:14px;color:var(--dmuted);margin:0}
.path-note{margin-top:36px;font-size:clamp(18px,2vw,22px);line-height:1.5;color:var(--dink);max-width:760px;border-left:3px solid var(--teal);padding-left:18px}
@media (max-width:900px){
  .path{grid-template-columns:1fr;gap:22px;padding-left:28px}
  .path::before{left:6px;right:auto;top:6px;bottom:6px;width:2px;height:auto;background:linear-gradient(180deg,var(--dline),var(--teal))}
  .path li{padding-top:0}
  .path li::before{left:-28px;top:3px}
  .contact .wrap.pw{margin-bottom:56px;padding-bottom:48px}
}
</style>

<div class="strip">Open to <b>Product Designer</b> roles in Toronto · Relocating Feb 2027</div>
<header class="bar">
  <div class="wrap"><a href="#top" class="me">Serena Zhang</a><nav><a href="#value" class="opt">Value</a><a href="#work">Work</a><a href="#awards" class="opt">Awards</a><a class="btn" href="#contact">Contact</a></nav></div>
</header>

<!-- 1 BANNER (white) -->
<section class="hero" id="top">
  <div class="wrap">
    <div>
      <p class="kicker">Zhang Si (Serena) · Product designer</p>
      <h1>I build products people come back to, and pay for.</h1>
      <p class="lede">10+ years designing products at Tencent. MS in UX Design at Laurier.</p>
      <div class="ctas"><a class="btn" href="#work">See my work →</a><a class="btn ghost" href="mailto:serene.zhangsi@gmail.com">Email me</a></div>
      <div class="facts"><span>MS, UX Design · Wilfrid Laurier University</span><span>Go · amateur 5-dan</span></div>
    </div>
    <figure class="hero-fig" aria-hidden="false">
      <svg viewBox="0 0 600 520" aria-hidden="true">
        <defs><filter id="brush" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035 0.6" numOctaves="3" seed="7"/><feDisplacementMap in="SourceGraphic" scale="26"/></filter></defs>
        <g filter="url(#brush)" fill="none" stroke-linecap="round">
          <path d="M70 150 C 210 110, 380 95, 540 70" stroke="#167D8D" stroke-width="70"/>
          <path d="M40 255 C 200 225, 400 200, 575 175" stroke="#167D8D" stroke-width="92"/>
          <path d="M80 360 C 240 335, 410 315, 560 290" stroke="#167D8D" stroke-width="64"/>
          <path d="M150 450 C 270 432, 390 420, 500 400" stroke="#167D8D" stroke-width="38"/>
          <path d="M120 205 C 260 185, 420 165, 520 150" stroke="#B9E4E8" stroke-width="6" opacity=".55"/>
        </g>
        <g fill="#167D8D"><circle cx="560" cy="120" r="7"/><circle cx="585" cy="230" r="5"/><circle cx="35" cy="320" r="6"/><circle cx="520" cy="440" r="4"/><circle cx="60" cy="110" r="4"/></g>
      </svg>
      <img src="/media/home/portrait-cut.webp" alt="Portrait of Serena Zhang in a black dress with a white bow" width="760" height="950">
    </figure>
  </div>
</section>

<!-- 2 VALUE (dark) -->
<section class="band" id="value">
  <div class="wrap">
    <div class="head"><p class="kicker">What I bring</p><h2>Big-platform experience, UX training, AI products</h2></div>
    <div class="vrow">
      <ol class="pts">
        <li><span class="n">01</span><div><h3>Big-platform experience</h3><p><b>7+ years at Tencent</b>. Tencent Video is China's No. 1 streaming service: <b>319M</b> monthly users, <b>117M</b> paid subscribers.</p></div></li>
        <li><span class="n">02</span><div><h3>UX training</h3><p><b>Master's in UX Design</b>, Wilfrid Laurier University. User research, usability testing and human-centred design.</p></div></li>
        <li><span class="n">03</span><div><h3>AI products</h3><p>AI character chat at Tencent Video: <b>800K users</b>, <b>30M+</b> conversation turns.</p></div></li>
      </ol>
      <div class="ev">
        <figure class="e1"><button type="button" data-src="/media/home/tencent-flixpatrol.jpg" aria-label="Enlarge streaming ranking"><img src="/media/home/tencent-flixpatrol.jpg" alt="FlixPatrol table of top streaming services in Asia by country, with China highlighted: No. 1 Tencent Video, No. 2 iQIYI"></button><figcaption>FlixPatrol: Tencent Video is No. 1 in China, by subscribers</figcaption></figure>
        <figure class="e2"><button type="button" data-src="/media/home/tencent-mau.jpg" aria-label="Enlarge video platform chart"><img src="/media/home/tencent-mau.jpg" alt="Chinese long-form video platforms by app monthly active users, June 2026: Tencent Video 319M, iQIYI 291M, Mango TV 243M, Youku 161M"></button><figcaption>Tencent Video leads China's four major long-form video apps, June 2026 · click to enlarge</figcaption></figure>
      </div>
    </div>
    <div class="loop">
      <h3>How I design: one loop, from logic to revenue</h3>
      <div class="steps">
