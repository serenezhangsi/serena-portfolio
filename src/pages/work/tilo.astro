<!-- HERO -->
<section class="hero" id="top">
  <div class="wrap">
    <div>
      <div class="eyebrow">Case study · The Tile Shoppe · Toronto · 2026</div>
      <h1>TILO: a name and a face for <em>Canada's first tile AI</em></h1>
      <p class="lede">A Toronto tile retailer hired me to name and brand its new AI assistant. I carried the brand all the way through: how TILO greets shoppers on the website, how its results read, and how the team measures it.</p>
      <div class="tags"><span class="tag">Brand identity</span><span class="tag">UI / UX</span><span class="tag">Product advisory</span><span class="tag">Data dashboard</span></div>
      <div class="scope" aria-label="My design scope: Product logic, UI / UX, Data"><span class="sl">My design scope</span><span class="p on">Product logic</span><span class="p on">UI / UX</span><span class="p on">Data</span><span class="p">Monetization</span></div>
      <dl class="meta">
        <div><dt>Role</dt><dd>Brand + UI/UX designer, product advisor</dd></div>
        <div><dt>Team</dt><dd>1 developer, 1 ops lead, client manager</dd></div>
        <div><dt>Timeline</dt><dd>May – Jun 2026</dd></div>
        <div><dt>Client</dt><dd>The Tile Shoppe, Concord ON</dd></div>
      </dl>
    </div>
    <div class="hero-art">
      <div class="browser"><div class="chrome"><i></i><i></i><i></i></div><img src="/media/tilo/site-live.jpg" alt="The Tile Shoppe homepage with the TILO Need Help tooltip and chat button in the corner"></div>
      <div class="phone-card"><img src="/media/tilo/card-after.jpg" alt="TILO photo-matching results: large square tile images, match badges, prices and View Product buttons"></div>
      <div class="logo-chip"><img src="/media/tilo/concept-1.jpg" alt="TILO logo: a robot head fused with a chat bubble, a tile on its antenna, and the tagline Hey, ask Tilo!"></div>
    </div>
