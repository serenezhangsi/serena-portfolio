---
import Base from '../../layouts/Base.astro';
---
<Base title="TILO Brand and Product Design · Serena Zhang" description="Case study: naming and branding The Tile Shoppe's AI assistant, from logo to website entry and admin dashboard.">
<style is:global>
/* Layout: a light, magazine-style case study. Deliberately single-theme (light) so the client's white brand assets sit naturally. Wide margins, a numbered week-by-week spine with text left and the design artifact right. */
:root{
  --paper:#FAF8F5; --surface:#FFFFFF; --ink:#1C1C1C; --muted:#6A645D; --line:#E6E1DA;
  --signal:#B85200; --fill:#FF7900; --soft:#FFF1E4;
  --display:"Bricolage Grotesque", "Avenir Next", "Segoe UI", sans-serif;
  --body:"IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --mono:"IBM Plex Mono", ui-monospace, Menlo, monospace;
  --wrap:1120px;
  color-scheme:light;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font:400 16px/1.65 var(--body);margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:24px}
img,video{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.02em;line-height:1.06;margin:0;text-wrap:balance}
h2{font-size:clamp(30px,4.2vw,48px)}
h3{font-size:22px;letter-spacing:-.01em}
p{margin:0;max-width:60ch}
.eyebrow{font:500 12px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--signal)}
.lede{font-size:18.5px;color:var(--muted)}
section{padding-block:112px}
.head{display:grid;gap:18px;margin-bottom:56px;max-width:780px}
.cap{font:400 12px/1.45 var(--mono);color:var(--muted);margin-top:12px}
:focus-visible{outline:2px solid var(--fill);outline-offset:3px}
figure{margin:0}
.rule{border:0;border-top:1px solid var(--line);margin:0}

.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:14px;font:500 13px var(--mono);color:var(--muted)}
.bar a{color:var(--ink);text-decoration:none}

/* hero */
.hero{padding-block:88px 72px}
.hero .wrap{display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(40px,6vw,76px);font-weight:800;margin-block:22px 26px;letter-spacing:-.035em}
.hero h1 em{font-style:normal;color:var(--fill)}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.tag{font:500 11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line);background:var(--surface);border-radius:99px;padding:6px 12px;color:var(--muted)}
.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:40px;padding-top:22px;border-top:1px solid var(--line)}
.meta dt{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.meta dd{margin:6px 0 0;font-weight:500;font-size:14.5px;line-height:1.4}
.hero-art{position:relative;padding:0 0 64px;margin-right:0}
.hero-art .browser{width:86%}
.phone-card{position:absolute;right:0;top:12%;width:30%;border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 30px 60px -24px #5a3a1a77,0 0 0 1px var(--line)}
.browser{border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 40px 80px -40px #5a3a1a55,0 0 0 1px var(--line)}
.browser .chrome{display:flex;gap:6px;padding:10px 12px;background:#F1EEE9}
.browser .chrome i{width:9px;height:9px;border-radius:50%;background:#D8D2C9}
.logo-chip{position:absolute;left:-28px;bottom:0;width:min(250px,42%);border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 24px 50px -20px #5a3a1a66,0 0 0 1px var(--line)}

/* numbers */
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid var(--line)}
.num{padding:32px 24px 32px 0;border-right:1px solid var(--line);display:grid;gap:10px;align-content:start}
.num + .num{padding-left:28px}
.num:last-child{border-right:0}
.num b{font:800 clamp(38px,5vw,62px)/.95 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.num b small{font-size:.45em;letter-spacing:-.01em;font-weight:700}
.num span{color:var(--muted);font-size:14px;max-width:26ch;line-height:1.45}
.num.live b{color:var(--fill)}
.num.live{background:var(--soft);padding-left:28px;margin-right:-24px;padding-right:24px}
.num-note{font:400 11.5px var(--mono);color:var(--muted);margin-top:12px}

/* web */
.web-wrap{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:48px;align-items:center}
.web{width:100%;height:auto;overflow:visible}
.svg-scroll{overflow-x:auto}
.legend{display:flex;gap:18px;flex-wrap:wrap;font:500 12px var(--mono);color:var(--muted);margin-top:22px}
.legend span{display:flex;align-items:center;gap:8px}
.legend i{width:14px;height:14px;border-radius:5px;display:inline-block}

/* weekly spine */
.spine{display:grid;gap:0;border-top:1px solid var(--line)}
.wk{display:grid;grid-template-columns:120px minmax(0,.8fr) minmax(0,1.2fr);gap:40px;padding-block:44px;border-bottom:1px solid var(--line);align-items:start}
.wk .when{font:500 12px/1.5 var(--mono);color:var(--signal);letter-spacing:.04em;position:sticky;top:72px}
.wk .when b{display:block;font:800 40px/1 var(--display);color:var(--ink);letter-spacing:-.03em;margin-bottom:6px}
.wk .txt{display:grid;gap:12px;align-content:start}
.wk .txt p{color:var(--muted);font-size:15.5px}
.wk ul{margin:0;padding-left:18px;color:var(--muted);font-size:15px;display:grid;gap:4px}
.wk .art{border-radius:16px;overflow:hidden;background:var(--surface);box-shadow:0 0 0 1px var(--line)}
.wk .art img,.wk .art video{width:100%}
.wk .art.flat{box-shadow:none;background:transparent;border-radius:0}
.pill-tag{justify-self:start;font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:99px;background:var(--fill);color:#1C1C1C}
.pill-tag.ghost{background:var(--soft);color:var(--signal)}
.q{border-left:3px solid var(--fill);padding:2px 0 2px 14px;font-size:14.5px;color:var(--ink)}
.q small{display:block;font:500 11px var(--mono);color:var(--muted);letter-spacing:.08em;margin-top:4px}


/* web card */
.web-wrap > *{min-width:0}
.web-card{background:var(--surface);border-radius:24px;box-shadow:0 0 0 1px var(--line);padding:clamp(16px,3vw,32px) clamp(16px,3vw,32px) 20px}
.web-card .legend{justify-content:center;margin-top:8px;padding-top:16px;border-top:1px solid var(--line)}

/* identity bento */
.bento{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}
.c2{grid-column:span 2}.c3{grid-column:span 3}.c4{grid-column:span 4}.c5{grid-column:span 5}.c7{grid-column:span 7}.c8{grid-column:span 8}.c12{grid-column:span 12}
.tile{position:relative;border-radius:20px;overflow:hidden;background:var(--surface);box-shadow:0 0 0 1px var(--line);min-height:220px;display:grid;place-items:center;padding:44px 22px 22px}
.tile .lab{position:absolute;left:22px;top:18px;font:500 11px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.tile .lab.inv{color:#ffffffb3}
.s2{grid-column:span 2}.s3{grid-column:span 3}.s4{grid-column:span 4}.s6{grid-column:span 6}
.t-hero{background:var(--fill);min-height:230px;box-shadow:none}
.t-hero img{width:min(60%,440px)}
.t-hero .tagline{position:absolute;left:24px;bottom:20px;right:24px;display:flex;justify-content:space-between;font:500 12px var(--mono);letter-spacing:.12em;color:#ffffffd9;text-transform:uppercase}
.t-ink{background:var(--ink);box-shadow:none}
.t-ink img{width:34%;max-width:120px}
.t-grid img{width:40%;max-width:150px;position:relative;z-index:1}
.t-grid svg.guides{position:absolute;inset:0;width:100%;height:100%}
.t-formula{padding:40px 24px 24px}
.t-formula img{width:100%}
.palette{display:grid;grid-template-columns:1.3fr 1fr .8fr;width:100%;height:100%;min-height:220px}
.t-pal{padding:0}
.sw{display:flex;flex-direction:column;justify-content:flex-end;padding:20px;font:400 11.5px/1.55 var(--mono);gap:2px}
.sw b{font:700 19px var(--display);letter-spacing:-.01em;margin-bottom:6px}
.sw.o{background:#FF7900;color:#1C1C1C}.sw.k{background:#1C1C1C;color:#F4F3F1}.sw.w{background:#FFFFFF;color:#1C1C1C;border-left:1px solid var(--line)}
.apps{display:grid;gap:26px;justify-items:center}
.apps .row{display:flex;gap:18px;align-items:flex-end;flex-wrap:wrap;justify-content:center}
.app{display:grid;place-items:center;border-radius:26%;box-shadow:0 10px 24px -14px #5a3a1a80}
.app img{width:62%}
.app.o{background:#FF7900}.app.w{background:#fff;box-shadow:0 0 0 1px var(--line),0 10px 24px -14px #5a3a1a80}.app.k{background:#1C1C1C}
.sizes{display:flex;gap:22px;align-items:flex-end}
.sizes figure{display:grid;gap:8px;justify-items:center;font:400 10.5px var(--mono);color:var(--muted)}
.t-cam{gap:14px}
.t-cam .cam{width:44%;max-width:180px}
.t-cam .eq{font:500 12px var(--mono);color:var(--muted);letter-spacing:.06em}
.t-soft{background:#F3EFEA;box-shadow:none}
.t-soft img{width:92%;border-radius:999px;box-shadow:0 20px 40px -24px #5a3a1a66}
.t-mock{padding:44px 36px 24px;background:#FFFFFF}
.t-mock img{width:92%}
.t-alt{align-content:center;justify-items:start;gap:10px;background:var(--paper)}
.t-alt img{width:100%;border-radius:12px;box-shadow:0 0 0 1px var(--line)}
.t-alt p{font-size:13.5px;color:var(--muted)}


.palette.v{grid-template-columns:1fr;grid-template-rows:1.3fr 1fr .7fr;min-height:220px}
.palette.v .sw{flex-direction:row;align-items:flex-end;justify-content:space-between;padding:12px 14px;font-size:10.5px}
.palette.v .sw b{font-size:13px;margin:0}
.palette.v .sw.w{border-left:0;border-top:1px solid var(--line)}
.apps.sm{gap:16px}.apps.sm .app{width:52px!important;height:52px!important}
.t-cam .cam{width:38%;max-width:110px}
.t-soft img{width:100%}
.t-mock img{width:62%}


.t-white{background:#fff}
.t-white img{width:min(82%,330px)}
.t-hero img{width:min(68%,360px)}
.t-camflow{min-height:0;padding:48px 24px 22px}
.cf{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;flex-wrap:wrap}
.cf-step{display:grid;justify-items:center;gap:8px}
.cf-step small{font:500 10.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.cf-box{width:76px;height:76px;border-radius:18px;background:var(--paper);display:grid;place-items:center}
.cf-box.on{background:var(--soft);box-shadow:0 0 0 1.5px #FFB37A}
.cf-box .cam{width:58%}
.cf-op{font:600 20px var(--display);color:var(--fill)}
.cf-div{width:1px;height:64px;background:var(--line)}
.cf-vars{display:flex;gap:8px}
.cf-vars .v{width:46px;height:46px;border-radius:12px;display:grid;place-items:center}
.cf-vars .v .cam{width:62%}
.cf-vars .v.w{background:#fff;box-shadow:0 0 0 1px var(--line)}.cf-vars .v.o{background:#FF7900}.cf-vars .v.k{background:#1C1C1C}
.cf-sizes{display:flex;align-items:flex-end;gap:14px;height:56px}
.cf-sb img{width:260px;border-radius:8px}
.palette .sw{justify-content:flex-end}

.bento .tile{min-height:200px}
.t-grid img{width:62%!important;max-width:120px!important}
.t-ink img{width:56%!important}
.t-white img,.t-hero img{width:min(80%,340px)!important}
.t-apps .apps.sm .app{width:34px!important;height:34px!important;border-radius:9px}
.t-apps .apps.sm .row{flex-wrap:nowrap}
.t-apps .apps.sm .row{gap:8px}
.t-apps .sizes{gap:12px}
.t-apps .sizes img[style*="44px"]{width:30px!important}.t-apps .sizes img[style*="32px"]{width:22px!important}.t-apps .sizes img[style*="24px"]{width:16px!important}
.t-pal .palette.v{min-height:200px}
.t-formula{padding:44px 18px 18px}
.bento .tile.t-hero{min-height:300px}
.bento .t-hero img{width:min(62%,420px)!important}
.bento .t-ink img{width:36%!important;max-width:130px}
.bento .t-grid img{width:44%!important;max-width:150px!important}
.t-pal2{padding:0!important;min-height:220px}
.stripes{display:grid;grid-template-columns:repeat(3,1fr);width:100%;height:100%;min-height:220px}
.stripes div{display:flex;align-items:flex-end;justify-content:center;padding-bottom:16px}
.stripes div:last-child{box-shadow:inset 1px 0 0 var(--line)}
.stripes span{writing-mode:vertical-rl;transform:rotate(180deg);font:500 12px var(--mono);letter-spacing:.08em}
.apps.sm2{display:grid;gap:22px;justify-items:center}
.apps.sm2 .row{display:flex;gap:12px}
.apps.sm2 .app{width:52px;height:52px}

/* brand board */
.board-frame{overflow:hidden;border-radius:28px;background:#EFEAE4;padding:clamp(10px,2vw,28px)}
.board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;transform:rotate(-3deg) scale(1.1);transform-origin:center;margin-block:3%}
.bt{position:relative;overflow:hidden;border-radius:6px;min-height:0;aspect-ratio:4/3;display:grid;place-items:center}
.bt img{display:block}
.b-glow{background:radial-gradient(circle at 50% 50%,#8A3E00 0,#2A1404 45%,#0E0B09 75%)}
.coin{width:46%;aspect-ratio:1;border-radius:50%;background:#FF7900;display:grid;place-items:center;box-shadow:0 0 0 10px #FF790022,0 30px 60px -10px #000}
.coin img{width:62%}
.b-orange{background:#FF7900;align-content:center;gap:16px}
.bbox{position:relative;width:68%;padding:10px 14px;outline:1.5px solid #ffffffcc}
.bbox img{width:100%}
.bbox .h{position:absolute;width:10px;height:10px;background:#FF7900;border:1.5px solid #fff}
.h.tl{left:-6px;top:-6px}.h.tr{right:-6px;top:-6px}.h.bl{left:-6px;bottom:-6px}.h.br{right:-6px;bottom:-6px}
.micro{max-width:30ch;text-align:center;font-size:9.5px;line-height:1.5;color:#ffffffcc;margin:0}
.b-cream{background:#FF7900;place-items:center start}
.b-cream .bleed{width:150%;max-width:none;margin-left:12%;filter:brightness(0) invert(1)}
.b-ui{background:#fff;aspect-ratio:4/4.4;place-items:center}
.b-ui .card{position:absolute;right:9%;top:8%;width:38%;border-radius:12px;box-shadow:0 20px 40px -18px #5a3a1a88,0 0 0 1px var(--line);transform:rotate(4deg)}
.b-ui .pill{position:absolute;left:6%;bottom:16%;width:72%;border-radius:999px;box-shadow:0 20px 40px -20px #5a3a1a77}
.b-mix{background:transparent;aspect-ratio:4/4.4;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:10px;place-items:stretch}
.m{border-radius:6px;overflow:hidden;position:relative;display:grid;place-items:center}
.pattern{background:#FF7900 url(/media/tilo/icon-white.png) 0 0/38px auto space;opacity:1}
.m.cam{background:#FFF1E4;gap:6px;align-content:center;justify-items:center}
.m.cam .cam{width:44%}
.m.cam span{font:500 9px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.m.stripes{display:grid;grid-template-columns:repeat(3,1fr);place-items:stretch}
.m.stripes div{display:flex;align-items:flex-end;justify-content:center;padding-bottom:10px}
.m.stripes div:last-child{box-shadow:inset 1px 0 0 var(--line)}
.m.stripes span{writing-mode:vertical-rl;transform:rotate(180deg);font:500 10px var(--mono);letter-spacing:.06em}
.m.grid{background:#fff}
.m.grid .guides{position:absolute;inset:0;width:100%;height:100%}
.m.grid img{width:46%;position:relative}
.b-laptop{background:linear-gradient(160deg,#F4F1EC,#E2DCD4);aspect-ratio:4/4.4}
.b-laptop img{width:118%;max-width:none;margin-left:-6%}
.b-site{background:#FF7900}
.b-site{align-content:center;gap:14px}
.b-site img{width:88%;border-radius:10px;box-shadow:0 30px 50px -24px #00000088}
.sb-cap{font:700 clamp(16px,1.8vw,22px) var(--display);color:#fff;letter-spacing:-.01em}
.b-dark{background:#1C1C1C}
.b-dark img{width:66%}
.b-app{background:linear-gradient(180deg,#E9E7E4,#D9D6D2)}
.app3d{width:40%;aspect-ratio:1;border-radius:24%;background:linear-gradient(145deg,#FF9533,#FF7900 55%,#E06800);display:grid;place-items:center;transform:rotate(-10deg);box-shadow:inset 0 -6px 0 #C85C00,0 30px 40px -14px #6a3a10aa}
.app3d img{width:62%}
.formula-strip{margin:20px 0 0;background:#fff;border-radius:20px;box-shadow:0 0 0 1px var(--line);padding:18px 24px}
.formula-strip img{width:100%;max-width:820px;margin-inline:auto}
@media (max-width:900px){.board{grid-template-columns:1fr 1fr;transform:none;margin:0}.b-mix,.b-laptop,.b-ui{aspect-ratio:1}}
@media (max-width:560px){.board{grid-template-columns:1fr}}

.bento .tile.t-hero{min-height:340px;padding-bottom:64px}
.bento .t-grid{min-height:280px;padding-bottom:36px}
.bento .t-formula{padding-bottom:36px}
/* journey */
.journey{position:relative;display:grid;gap:0}
.journey::before{content:"";position:absolute;left:150px;top:10px;bottom:10px;width:2px;background:linear-gradient(var(--fill),var(--fill) 85%,#FFD3A8)}
.stop{display:grid;grid-template-columns:150px minmax(0,1fr);gap:0 48px;padding-bottom:72px;position:relative}
.stop:last-child{padding-bottom:0}
.stop .date{text-align:right;padding-right:28px;font:600 13px/1.35 var(--mono);color:var(--ink);letter-spacing:.02em;padding-top:4px}
.stop .date small{display:block;font-weight:400;color:var(--muted);font-size:11.5px;margin-top:4px;letter-spacing:.06em;text-transform:uppercase}
.stop::before{content:"";position:absolute;left:144px;top:6px;width:14px;height:14px;border-radius:50%;background:var(--paper);border:3px solid var(--fill);z-index:1}
.stop.end::before{background:var(--fill)}
.stop .body{display:grid;gap:12px;min-width:0}
.stop .body p{color:var(--muted);font-size:15.5px;max-width:68ch}
.stop .media{margin-top:12px;display:grid;gap:14px}
.stop .media.two{grid-template-columns:1.25fr 1fr;align-items:start}
.stop .shot{border-radius:16px;overflow:hidden;background:var(--surface);box-shadow:0 0 0 1px var(--line),0 30px 60px -40px #5a3a1a55}
.stop .shot img,.stop .shot video{width:100%}
.stop .q{max-width:60ch}


/* journey v2: sticky date panel */
.journey2{display:grid;grid-template-columns:210px minmax(0,1fr);gap:56px;align-items:start}
.jdate{position:sticky;top:96px}
.jbig{font:800 34px/1.05 var(--display);letter-spacing:-.03em;color:var(--ink);transition:opacity .25s}
.jstage{font:500 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--signal);margin-top:10px}
.jlist{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:10px;font:500 12.5px var(--mono);color:#B9B1A7}
.jlist li{padding-left:16px;position:relative;transition:color .2s}
.jlist li::before{content:"";position:absolute;left:0;top:.55em;width:7px;height:7px;border-radius:50%;background:currentColor}
.jlist li.on{color:var(--fill)}
.stops{display:grid;gap:96px}
.stops .stop{display:block;padding:0}
.stops .stop::before{display:none}
.stops .stop .date{display:none}
.stops .body h3{font-size:26px}
.closing{margin-top:28px;padding-top:28px;border-top:1px solid var(--line);display:grid;gap:14px}
.closing .loop{margin:4px 0 10px}

/* loop + dashboard */
.loop{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:36px}
.loop span{font:600 14px var(--body);padding:10px 16px;border-radius:12px;background:var(--surface);box-shadow:0 0 0 1px var(--line)}
.loop span.on{background:var(--fill);color:#1C1C1C;box-shadow:none}
.loop i{font-style:normal;color:var(--muted)}
.dash{border-radius:18px;overflow:hidden;box-shadow:0 40px 80px -40px #5a3a1a55,0 0 0 1px var(--line);background:#fff}
.dash-row{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;margin-top:28px}
.btn{display:inline-flex;gap:8px;align-items:center;padding:13px 20px;border-radius:99px;background:var(--ink);color:#fff;font-weight:600;text-decoration:none}
.btn:hover{background:var(--signal)}
.dash-row small{font:400 12.5px var(--mono);color:var(--muted)}

/* testimonial */
.testi{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:start}
.testi .mark{font:800 120px/0.8 var(--display);color:var(--fill)}
.testi blockquote{margin:0;font:500 clamp(21px,2.5vw,30px)/1.4 var(--display);letter-spacing:-.015em;max-width:30em}
.testi blockquote em{font-style:normal;background:linear-gradient(transparent 62%,#FFD3A8 62%)}
.testi .who{margin-top:24px;font-size:14px;color:var(--muted)}
.testi .who b{color:var(--ink);font-weight:600}

.refl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px}
.refl div{border-top:2px solid var(--ink);padding-top:18px;display:grid;gap:10px}
.refl p{color:var(--muted);font-size:15px}

.next{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.next a{display:grid;gap:8px;padding:28px;border-radius:20px;background:var(--surface);box-shadow:0 0 0 1px var(--line);color:var(--ink);text-decoration:none;transition:box-shadow .2s}
.next a:hover{box-shadow:0 0 0 2px var(--fill)}
.next small{font:500 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.next b{font:700 24px var(--display)}

@media (max-width:900px){
  section{padding-block:72px}
  .hero .wrap,.web-wrap{grid-template-columns:1fr}
  .meta,.nums{grid-template-columns:repeat(2,minmax(0,1fr))}
  .num{border-right:0;border-bottom:1px solid var(--line);padding-left:0!important}
  .num.live{margin-right:0;padding-left:16px!important}
  .wk{grid-template-columns:1fr;gap:16px}
  .wk .when{position:static}
  .wk .when b{display:inline;font-size:28px;margin-right:10px}
  .refl,.next{grid-template-columns:1fr}
  .testi{grid-template-columns:1fr;gap:0}
  .testi .mark{font-size:80px}
  .logo-chip{left:auto;right:10px;width:38%}
  .web{min-width:620px}
  .bento{grid-template-columns:1fr 1fr}
  .c2,.c3{grid-column:span 1}.c4,.c5,.c7,.c8,.c12{grid-column:span 2}
  .t-ink,.t-grid{grid-column:span 1}
  .t-white{grid-column:span 1}.c5{grid-column:span 2}
  .cf{justify-content:center}.cf-div{display:none}
  .t-mock img{width:96%}
  .hero-art .browser{width:100%}.phone-card{display:none}
  .journey2{grid-template-columns:1fr;gap:0}
  .jdate{display:none}
  .stops{gap:64px}
  .stops .stop .date{display:block;text-align:left;padding:0 0 6px;font:600 13px var(--mono);color:var(--signal)}
  .stops .stop .date small{display:inline;margin-left:8px}
  .stop{grid-template-columns:1fr;padding-left:32px;padding-bottom:56px}
  .stop::before{left:1px}
  .stop .date{text-align:left;padding:0 0 8px}
  .stop .media.two{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
/* design scope strip */
.scope{margin-top:20px;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.scope .sl{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;opacity:.75;margin-right:4px}
.scope .p{font:600 12.5px var(--body);padding:6px 12px;border-radius:99px;border:1px dashed currentColor;opacity:.4}
.scope .p.on{opacity:1;border:1px solid transparent;background:var(--scope-bg);color:var(--scope-ink)}
.hero .scope{color:var(--muted);--scope-bg:var(--fill);--scope-ink:#1C1C1C}
