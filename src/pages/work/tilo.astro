    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)setI(+e.target.getAttribute('data-i'))})},{rootMargin:'-35% 0px -55% 0px'});
    stops.forEach(function(st){io.observe(st)});
  }
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('video').forEach(function(v){
    if(reduce){v.removeAttribute('autoplay');v.pause();v.controls=true;}
    else{var p=v.play();if(p&&p.catch)p.catch(function(){v.controls=true;});}
  });
})();
</script>
