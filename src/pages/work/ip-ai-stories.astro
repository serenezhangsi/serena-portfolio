<!-- STUDIO -->
<section class="stage">
  <div class="wrap">
    <div class="head" style="margin-bottom:0">
      <div class="eyebrow">Creator studio</div>
      <h2>An immersive story in three steps</h2>
      <p class="was">Before: <s>script → mechanics → art → audio → QA</s></p>
    </div>
    <div class="steps">
      <div class="step"><small>STEP 1</small><b>Your idea</b><span>Premise, lead, relationships</span></div>
      <div class="step"><small>STEP 2</small><b>AI writes the plot</b><span>Branches on a free canvas</span></div>
