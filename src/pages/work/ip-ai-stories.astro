---
import Base from '../../layouts/Base.astro';
---
<Base title="IP + AI Interactive Stories · Serena Zhang" description="Case study: a 0-to-1 AI product at Tencent Video that lets fans talk with characters and shape their own endings.">
<style is:global>
/* Layout: light reading pages for argument + diagrams, dark "stage" bands where the product's own (dark) screens live. */
:root{
  --paper:#F1F2F6; --surface:#FFFFFF; --ink:#13151B; --muted:#596074; --line:#D8DBE5;
  --signal:#2B5CFF; --signal-soft:#E3E9FF; --stage:#0D0E13; --stage-2:#191B23; --stage-ink:#F1F2F6; --stage-muted:#9AA0B4;
  --display:"Bricolage Grotesque", "Avenir Next", "Segoe UI", sans-serif;
  --body:"IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --mono:"IBM Plex Mono", ui-monospace, Menlo, monospace;
  --wrap:1120px;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --paper:#111318; --surface:#1A1D25; --ink:#ECEEF4; --muted:#A1A7BA; --line:#2C303B;
  --signal:#7A97FF; --signal-soft:#1E2747; --stage:#08090C; --stage-2:#15171E; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#111318; --surface:#1A1D25; --ink:#ECEEF4; --muted:#A1A7BA; --line:#2C303B;
  --signal:#7A97FF; --signal-soft:#1E2747; --stage:#08090C; --stage-2:#15171E; color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font:400 16px/1.6 var(--body);margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:24px}
img,video{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.02em;line-height:1.08;margin:0;text-wrap:balance}
h2{font-size:clamp(28px,4vw,44px)}
h3{font-size:20px;letter-spacing:-.01em}
p{margin:0;max-width:62ch}
.eyebrow{font:500 12px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--signal)}
.lede{font-size:18px;color:var(--muted)}
section{padding-block:96px}
.head{display:grid;gap:16px;margin-bottom:48px;max-width:760px}
:focus-visible{outline:2px solid var(--signal);outline-offset:3px}

/* top bar */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--stage) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid #ffffff14}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:14px;font:500 13px var(--mono);color:var(--stage-muted)}
.bar a{color:var(--stage-ink);text-decoration:none}

/* stage bands */
.stage{background:var(--stage);color:var(--stage-ink)}
.stage .lede,.stage p{color:var(--stage-muted)}
.stage .eyebrow{color:#8FA8FF}

/* hero */
.hero{padding-block:72px 88px;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero h1{font-size:clamp(40px,6.4vw,76px);font-weight:800;margin-block:20px 24px}
.hero h1 em{font-style:normal;color:#8FA8FF}
.hero .lede{font-size:19px;color:#C9CDDA}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.tag{font:500 11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;border:1px solid #ffffff2b;border-radius:99px;padding:6px 12px;color:#C9CDDA}
.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:40px;padding-top:24px;border-top:1px solid #ffffff1f}
.meta dt{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--stage-muted)}
.meta dd{margin:6px 0 0;font-weight:500;color:var(--stage-ink);font-size:15px}
.phones{position:relative;display:flex;justify-content:center;gap:20px;align-items:flex-start}
.phone{width:min(230px,44%);aspect-ratio:9/17.5;border-radius:30px;background:#000;border:7px solid #23252E;overflow:hidden;box-shadow:0 30px 80px -20px #000}
.phone video,.phone img{width:100%;height:100%;object-fit:cover}
.phones .phone:nth-child(2){margin-top:64px}
.cap{font:400 12px/1.4 var(--mono);color:var(--muted);margin-top:12px}
.stage .cap{color:var(--stage-muted)}

/* numbers */
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line)}
.num{padding:28px 24px 28px 0;border-right:1px solid var(--line)}
.num:last-child{border-right:0}
.num b{display:block;font:800 clamp(34px,4.6vw,56px)/1 var(--display);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.num span{display:block;margin-top:10px;color:var(--muted);font-size:14px;max-width:24ch}
.num + .num{padding-left:24px}

/* generic two-col */
.split{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:56px;align-items:center}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:28px}
svg text{font-family:var(--body)}
.svg-wrap{overflow-x:auto}

/* chips */
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.chip{display:flex;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 14px;font-size:14px;font-weight:500}
.chip i{font:500 11px var(--mono);font-style:normal;color:var(--signal)}

/* compare */
.compare{display:grid;grid-template-columns:120px minmax(0,1fr) minmax(0,1fr);border:1px solid var(--line);border-radius:20px;overflow:hidden;background:var(--surface)}
.compare > div{padding:18px 20px;border-top:1px solid var(--line);font-size:15px}
.compare .h{border-top:0;font:600 13px var(--mono);letter-spacing:.06em;text-transform:uppercase}
.compare .rl{font:500 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.compare .us{background:var(--signal-soft)}
.compare .h.us{color:var(--signal)}
.compare .them{color:var(--muted)}

/* formula */
.formula{display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px;margin-top:40px;font-family:var(--display);font-weight:800;letter-spacing:-.02em}
.formula .t{font-size:clamp(26px,3.6vw,40px)}
.formula .op{font-size:clamp(22px,3vw,32px);color:var(--muted);font-weight:500}
.formula .hl{color:var(--signal)}
.formula .box{border:2px solid var(--ink);border-radius:14px;padding:8px 14px 10px;font-size:clamp(16px,1.8vw,19px);display:grid;gap:2px}
.formula .box small{font:400 12px/1.3 var(--body);letter-spacing:0;color:var(--muted)}
.formula .box.out{border-color:var(--signal);background:var(--signal-soft);color:var(--signal)}

/* decisions */
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:28px;display:grid;gap:14px;align-content:start}
.card .k{font:500 12px var(--mono);color:var(--signal);letter-spacing:.1em;text-transform:uppercase}
.card p{color:var(--muted);font-size:15px}
.trade{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:14px;padding-top:14px;border-top:1px dashed var(--line)}
.trade b{font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;padding-top:3px}
.trade .give{color:var(--muted)}
.trade .get{color:var(--ink)}

/* architecture */
.arch{display:grid;grid-template-columns:minmax(0,1fr) 40px minmax(0,1.5fr) 40px minmax(0,1fr);align-items:stretch}
.arch .col{display:grid;gap:12px;align-content:center}
.arch .arrow{display:grid;place-items:center;color:var(--muted);font-size:22px}
.node{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.node h4{margin:0 0 8px;font:600 15px var(--body)}
.node ul{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:6px}
.node li{font-size:12.5px;background:var(--paper);border-radius:6px;padding:3px 8px;color:var(--muted)}
.node .lbl{font:500 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
.node.main{border:2px solid var(--signal);background:var(--signal-soft)}
.node.main .lbl{color:var(--signal)}
.node.base{background:transparent;border-style:dashed}

/* feed */
.feed{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:56px;align-items:center}
.feed img{border-radius:16px}
.big{font:800 clamp(56px,8vw,96px)/1 var(--display);letter-spacing:-.04em;color:var(--stage-ink);margin-top:32px}
.big + span{color:var(--stage-muted);font-size:15px}

/* features */
.feats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:hidden;margin-block:40px}
.feat{background:var(--surface);padding:22px}
.feat b{display:block;font-weight:600;margin-bottom:4px}
.feat span{color:var(--muted);font-size:14px}
.shot{border-radius:18px;overflow:hidden;background:var(--stage)}
.duo{display:grid;grid-template-columns:240px minmax(0,1fr);gap:32px;align-items:start}

/* strategies */
.metrics{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:56px}
.metric{display:flex;gap:14px;align-items:baseline;border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:14px 18px}
.metric b{font:600 15px var(--body)}
.metric span{font:400 13px var(--mono);color:var(--muted)}
.strat{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center;padding-block:56px;border-top:1px solid var(--line)}
.strat .n{font:500 12px var(--mono);letter-spacing:.12em;color:var(--signal)}
.strat h3{font-size:clamp(22px,2.6vw,30px);margin-block:10px 14px}
.strat p{color:var(--muted)}
.bars{display:grid;gap:18px;margin-top:28px}
.barrow{display:grid;gap:6px}
.barrow .top{display:flex;justify-content:space-between;font-size:14px}
.barrow .top b{font-weight:600}
.barrow .top em{font-style:italic;color:var(--muted)}
.track{display:flex;height:14px;border-radius:99px;overflow:hidden;background:var(--line)}
.track .ai{background:var(--signal)}
.legend{display:flex;gap:18px;font:400 12px var(--mono);color:var(--muted)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.withphone{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:28px;align-items:center}
.withphone img{border-radius:18px}

.shiftshot{margin:0 0 48px;background:var(--stage);border-radius:24px;padding:clamp(12px,2.4vw,28px)}
.pairs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(8px,1.6vw,20px)}
.pairs img{width:100%;border-radius:14px}
.shiftshot .cap{color:var(--stage-muted);margin-top:14px}
.shifts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}
.shift{display:grid;gap:12px;align-content:start;border-top:2px solid var(--ink);padding-top:20px}
.shift .n{font:500 12px var(--mono);letter-spacing:.12em;color:var(--signal)}
.shift h3{font-size:24px}
.shift p{color:var(--muted);font-size:15px}
.formula.mini{margin-top:8px;gap:8px}
.formula.mini .box{font-size:14px;padding:6px 10px;border-width:1.5px;border-radius:10px}
.formula.mini .op{font-size:16px}
.shift .bars{margin-top:8px}
.shift svg{max-width:340px}
.studio-video{width:100%;border-radius:16px}
.mech{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;background:var(--stage);border-radius:18px;padding:14px}
.mech figure{margin:0}
.mech img{width:100%;aspect-ratio:358/772;object-fit:cover;border-radius:10px}
.mech figcaption{font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--stage-muted);margin-top:8px;text-align:center}
.entries{max-width:920px;margin:72px auto 0}
.entry-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:16px}
.entry-grid figure{margin:0;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:12px;display:grid;gap:10px;align-content:start}
.entry-grid img{width:100%;border-radius:10px}
.entry-grid .e-char{grid-row:span 2}
.entry-grid figcaption{font-size:13.5px;color:var(--muted)}
.entry-grid figcaption b{display:block;color:var(--ink);font-weight:600}
.fans{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.fcard{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:26px;display:grid;gap:14px;align-content:start;min-width:0}
.fk{font:500 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.fcard h4{margin:0;font:700 22px/1.2 var(--display);letter-spacing:-.01em}
.src{font-size:12.5px;color:var(--muted)}
.hbars{display:grid;gap:8px}
.hrow{display:grid;grid-template-columns:96px minmax(0,1fr) 44px;align-items:center;gap:10px;font-size:13.5px}
.hrow span{color:var(--muted)}
.hrow em{font-style:normal;font-variant-numeric:tabular-nums;text-align:right;color:var(--muted)}
.htrack{height:12px}
.htrack b{display:block;height:100%;background:color-mix(in srgb,var(--signal) 35%,var(--surface));border-radius:0 4px 4px 0}
.hrow.hi b{background:var(--signal)}
.hrow.hi span,.hrow.hi em{color:var(--ink);font-weight:600}
.vbars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;align-items:end;height:190px}
.vcol{display:grid;grid-template-rows:auto 1fr auto;height:100%;gap:4px;text-align:center}
.vcol em{font-style:normal;font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.vbar{display:flex;align-items:flex-end}
.vbar b{width:100%;background:color-mix(in srgb,var(--signal) 35%,var(--surface));border-radius:4px 4px 0 0;min-height:2px}
.vcol.hi b{background:var(--signal)}
.vcol span{font-size:11.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:4px}
.hours{display:grid;grid-template-columns:repeat(24,minmax(0,1fr));gap:2px;align-items:end;height:150px;border-bottom:1px solid var(--line)}
.hours i{display:block;background:color-mix(in srgb,var(--signal) 35%,var(--surface));border-radius:3px 3px 0 0}
.hours i.hi{background:var(--signal)}
.hours-axis{display:flex;justify-content:space-between;font:400 11px var(--mono);color:var(--muted);margin-top:-6px}
.phrases{display:grid;gap:16px}
.phrases small{display:block;font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.phrases span{display:inline-grid;margin:0 6px 8px 0;padding:6px 12px;border-radius:12px;background:var(--signal-soft);color:var(--ink);font-weight:600;line-height:1.25}
.phrases span i{font-style:normal;font-weight:400;font-size:11.5px;color:var(--muted)}
.phrases .p1{font-size:20px;background:var(--signal);color:#fff}
.phrases .p1 i{color:#ffffffcc}
.phrases .p2{font-size:16px}
.phrases .p3{font-size:14px;background:var(--paper)}
[data-tip]{cursor:default}
.tip{position:fixed;z-index:20;pointer-events:none;background:var(--ink);color:var(--paper);font:500 12px var(--mono);padding:6px 9px;border-radius:8px;transform:translate(-50%,-130%);white-space:nowrap}
/* studio */
.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-block:40px 32px}
.step{position:relative;padding:22px 40px 22px 26px;background:var(--stage-2);color:var(--stage-ink);clip-path:polygon(0 0,calc(100% - 22px) 0,100% 50%,calc(100% - 22px) 100%,0 100%,22px 50%)}
.step:first-child{clip-path:polygon(0 0,calc(100% - 22px) 0,100% 50%,calc(100% - 22px) 100%,0 100%);border-radius:12px 0 0 12px}
.step:nth-child(1){background:var(--signal);color:#fff}
.step small{font:500 11px var(--mono);letter-spacing:.1em;opacity:.75}
.step b{display:block;font:700 19px var(--display);margin-block:4px}
.step span{font-size:13.5px;opacity:.8}
.step + .step{margin-left:-10px}
.was{font:400 14px var(--mono);color:var(--stage-muted)}
.was s{opacity:.7}
.studio-media{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:20px}
.studio-media video,.studio-media img{border-radius:14px;width:100%}

/* results */
.grid6{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.grid6 div{background:var(--surface);padding:28px}
.grid6 b{display:block;font:800 clamp(36px,4.4vw,52px)/1 var(--display);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.grid6 span{display:block;margin-top:10px;color:var(--muted);font-size:14.5px}
.impact{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 40px;margin-top:40px;padding:0;list-style:none}
.impact li{padding-left:22px;position:relative;font-size:15px}
.impact li::before{content:"";position:absolute;left:0;top:.6em;width:10px;height:2px;background:var(--signal)}
.note{font-size:13px;color:var(--muted);margin-top:20px;max-width:80ch}

/* reflection */
.refl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}
.refl div{border-top:2px solid var(--ink);padding-top:18px;display:grid;gap:10px}
.refl p{color:var(--muted);font-size:15px}

.next{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.next a{display:grid;gap:8px;padding:28px;border-radius:20px;border:1px solid #ffffff22;color:var(--stage-ink);text-decoration:none;transition:border-color .2s,background .2s}
.next a:hover{border-color:#8FA8FF;background:#ffffff08}
.next small{font:500 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--stage-muted)}
.next b{font:700 24px var(--display)}

@media (max-width:860px){
  section{padding-block:64px}
  .hero .wrap,.split,.feed,.strat,.duo{grid-template-columns:1fr}
  .meta{grid-template-columns:repeat(2,minmax(0,1fr))}
  .nums{grid-template-columns:repeat(2,minmax(0,1fr))}
  .num{border-right:0;border-bottom:1px solid var(--line);padding-left:0!important}
  .cards,.refl,.feats,.grid6,.impact,.next,.shifts,.fans{grid-template-columns:1fr}
  .mech{grid-template-columns:repeat(2,minmax(0,1fr))}
  .entry-grid{grid-template-columns:1fr}
  .entry-grid .e-char{grid-row:auto;max-width:260px}
  .arch{grid-template-columns:1fr}
  .arch .arrow{transform:rotate(90deg);height:32px}
  .steps{grid-template-columns:1fr;gap:8px}
  .step,.step:first-child{clip-path:none;border-radius:12px;margin-left:0!important}
  .compare{grid-template-columns:90px minmax(0,1fr) minmax(0,1fr)}
  .compare > div{padding:14px 12px;font-size:14px}
  .withphone{grid-template-columns:1fr 130px;gap:16px}
  .duo .phone{margin-inline:auto}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header class="bar">
  <div class="wrap"><a href="/">Serena Zhang</a><span>Case study 01 / 03</span></div>
</header>

<!-- HERO -->
<section class="stage hero" id="top">
  <div class="wrap">
    <div>
      <div class="eyebrow">Case study · Tencent Video · 2024</div>
      <h1>IP + AI: stepping <em>inside</em> the story</h1>
      <p class="lede">I led a 0-to-1 AI product that lets fans keep living inside the shows they love: talking with the characters, unlocking new chapters and shaping their own endings.</p>
      <div class="tags"><span class="tag">AI product</span><span class="tag">0 → 1</span><span class="tag">Interactive storytelling</span><span class="tag">Creator tools</span></div>
      <dl class="meta">
        <div><dt>Role</dt><dd>Lead PM</dd></div>
        <div><dt>Team</dt><dd>14 people</dd></div>
        <div><dt>Cadence</dt><dd>2-week sprints</dd></div>
        <div><dt>Shipped on</dt><dd>Tencent Video, QQ, Yuanbao</dd></div>
      </dl>
    </div>
    <div>
      <div class="phones">
        <div class="phone"><video src="/media/ip-ai-stories/galaxy-opening.mp4" poster="/media/ip-ai-stories/galaxy-opening-poster.jpg" autoplay muted loop playsinline aria-label="Opening film of the original story Galaxy Hunter"></video></div>
        <div class="phone"><video src="/media/ip-ai-stories/sins-opening.mp4" poster="/media/ip-ai-stories/sins-opening-poster.jpg" autoplay muted loop playsinline aria-label="Opening film of the original story Seven Deadly Sins"></video></div>
      </div>
      <p class="cap" style="text-align:center">Opening films for two original stories built on the platform</p>
    </div>
  </div>
</section>

<!-- NUMBERS -->
<section style="padding-block:0">
  <div class="wrap nums">
    <div class="num"><b>800K</b><span>users across 16 AI characters</span></div>
    <div class="num"><b>30M+</b><span>conversation turns</span></div>
    <div class="num"><b>37.5</b><span>turns per user, vs. an industry average of about 30</span></div>
    <div class="num"><b>18.37%</b><span>of fans kept chatting after the finale</span></div>
  </div>
</section>

<!-- PROBLEM -->
<section>
  <div class="wrap split">
    <div class="head" style="margin:0">
      <div class="eyebrow">The problem</div>
      <h2>When the show ends, the love doesn't.</h2>
      <p class="lede">Tencent Video runs on premium IP and membership revenue, much like Netflix. Every show has a finale, but fans' feelings carry on, and they take them to Weibo and Xiaohongshu. In 2024 we asked: beyond watching, what can a streaming platform give its fans?</p>
    </div>
    <div class="panel svg-wrap">
