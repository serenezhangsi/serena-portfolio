---
import Base from '../../layouts/Base.astro';
---
<Base title="Family Account · Serena Zhang" description="Case study: designing China's first family account system for elders and kids at Tencent Video, from account logic to pricing.">
<style is:global>
/* Same light editorial system as case 02, with a teal accent taken from the product's own action buttons. Dark band for the interaction boards so the original dark-canvas deliverables sit naturally. */
:root{
  --paper:#F7F8F6; --surface:#FFFFFF; --ink:#1A1D1C; --muted:#5F6664; --line:#E1E5E2;
  --signal:#0B6E66; --fill:#16B3A6; --soft:#E5F5F2; --gold:#F5C451; --cream:#FFF6E2;
  --stage:#1F2F2C; --stage-2:#283A37; --stage-ink:#EEF2F0; --stage-muted:#9AA5A1;
  --display:"Bricolage Grotesque","Avenir Next","Segoe UI",sans-serif;
  --body:"IBM Plex Sans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  --wrap:1120px; color-scheme:light;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font:400 16px/1.65 var(--body);margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-inline:24px}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.02em;line-height:1.06;margin:0;text-wrap:balance}
h2{font-size:clamp(30px,4.2vw,48px)}
h3{font-size:22px;letter-spacing:-.01em}
p{margin:0;max-width:62ch}
.eyebrow{font:500 12px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--signal)}
.lede{font-size:18.5px;color:var(--muted)}
section{padding-block:112px}
.head{display:grid;gap:18px;margin-bottom:56px;max-width:780px}
.cap{font:400 12px/1.5 var(--mono);color:var(--muted);margin-top:12px}
figure{margin:0}
:focus-visible{outline:2px solid var(--fill);outline-offset:3px}

.bar{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;padding-block:14px;font:500 13px var(--mono);color:var(--muted)}
.bar a{color:var(--ink);text-decoration:none}

/* hero */
.hero{padding-block:88px 80px}
.hero .wrap{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(40px,5.8vw,74px);font-weight:800;margin-block:22px 26px;letter-spacing:-.035em}
.hero h1 em{font-style:normal;color:var(--fill)}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
.tag{font:500 11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line);background:var(--surface);border-radius:99px;padding:6px 12px;color:var(--muted)}
.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:40px;padding-top:22px;border-top:1px solid var(--line)}
.meta dt{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.meta dd{margin:6px 0 0;font-weight:500;font-size:14.5px;line-height:1.4}
.fan{position:relative;aspect-ratio:1/1.02;background:radial-gradient(circle at 50% 55%,#DDF3EF 0,#EEF7F5 45%,transparent 70%)}
.ph{position:absolute;border-radius:26px;overflow:hidden;background:#fff;box-shadow:0 0 0 6px #fff,0 0 0 7px var(--line),0 40px 70px -30px #0d3b3666}
.ph img{width:100%}
.ph.a{width:36%;left:2%;top:16%;transform:rotate(-7deg)}
.ph.b{width:40%;left:30%;top:4%;z-index:2}
.ph.c{width:36%;right:2%;top:16%;transform:rotate(7deg)}
.chip{position:absolute;z-index:3;font:600 12px var(--mono);letter-spacing:.04em;background:var(--ink);color:#fff;border-radius:99px;padding:8px 14px;box-shadow:0 12px 24px -12px #0006}
.chip.l{left:0;bottom:12%}.chip.r{right:0;bottom:6%;background:var(--fill);color:var(--ink)}

/* numbers */
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid var(--line)}
.num{padding:32px 24px 32px 0;border-right:1px solid var(--line);display:grid;gap:10px;align-content:start}
.num + .num{padding-left:28px}
.num:last-child{border-right:0}
.num b{font:800 clamp(36px,4.8vw,60px)/.95 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.num b small{font-size:.45em;letter-spacing:-.01em;font-weight:700}
.num span{color:var(--muted);font-size:14px;max-width:26ch;line-height:1.45}
.num.hi{background:var(--soft);margin-right:-24px;padding-right:24px}
.num.hi b{color:var(--signal)}
.num-note{font:400 11.5px var(--mono);color:var(--muted);margin-top:12px}

/* system map */
.map-wrap{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:48px;align-items:center}
.map-wrap > *{min-width:0}
.map-card{background:var(--surface);border-radius:24px;box-shadow:0 0 0 1px var(--line);padding:clamp(14px,2.6vw,28px) clamp(14px,2.6vw,28px) 18px}
.svg-scroll{overflow-x:auto}
.map{width:100%;height:auto;min-width:0}
.legend{display:flex;gap:18px;flex-wrap:wrap;justify-content:center;font:500 12px var(--mono);color:var(--muted);margin-top:8px;padding-top:16px;border-top:1px solid var(--line)}
.legend span{display:flex;align-items:center;gap:8px}
.legend i{width:14px;height:14px;border-radius:5px;display:inline-block}
.layers{display:grid;gap:10px;margin-top:26px}
.layers div{display:grid;grid-template-columns:24px 1fr;gap:10px;font-size:14.5px;color:var(--muted)}
.layers b{color:var(--ink);font-weight:600}
.layers em{font-style:normal;font:600 12px var(--mono);color:var(--signal);padding-top:2px}

/* personas */
.cards3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.card{background:var(--surface);border-radius:20px;box-shadow:0 0 0 1px var(--line);padding:26px;display:grid;gap:12px;align-content:start}
.card .who{display:flex;align-items:center;gap:12px}
.av{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font:700 15px var(--display)}
.av.p{background:var(--ink);color:#fff}.av.e{background:var(--cream);color:#8A5A00}.av.k{background:var(--soft);color:var(--signal)}
.card h3{font-size:20px}
.card .sub{font:500 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.card p{color:var(--muted);font-size:15px}
.card .impact{margin-top:6px;padding-top:12px;border-top:1px dashed var(--line);font-size:14px;color:var(--ink)}
.card .impact b{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--signal);display:block;margin-bottom:4px}
.goal{margin-top:22px;display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:center;background:var(--ink);color:#fff;border-radius:20px;padding:22px 26px}
.goal b{font:800 30px/1 var(--display);color:var(--fill);letter-spacing:-.02em}
.goal p{color:#C9D2CF;font-size:15px;max-width:none}


/* relationship triangle */
.tri-card{background:var(--surface);border-radius:24px;box-shadow:0 0 0 1px var(--line);padding:clamp(16px,3vw,36px) clamp(12px,3vw,36px) 20px;margin-bottom:22px;display:grid;grid-template-columns:minmax(0,.62fr) minmax(0,1.38fr);gap:32px;align-items:center}
.tri-card > *{min-width:0}
.tri-txt{display:grid;gap:14px}
.tri-txt h3{font-size:26px}
.tri-txt p{color:var(--muted);font-size:15.5px}
.tri-key{display:grid;gap:8px;font:500 12px var(--mono);color:var(--muted);margin-top:6px}
.tri-key span{display:flex;align-items:center;gap:10px}
.tri-key i{display:inline-block;width:28px;height:0;border-top:3px solid #16B3A6}
.tri-key i.t{border-top:2.5px dashed #E2725B}
.tri-key i.h{border-top:1.5px dotted #9AA5A1}
.tri{width:100%;height:auto;display:block}
.tri-i{font:700 28px var(--display);fill:#1A1D1C}.tri-i.w{fill:#fff}
.tri-n{font:700 17px var(--display);fill:#1A1D1C}
.tri-s{font:400 13px var(--body);fill:#5F6664}
.tri-h{font:700 16px var(--display);fill:#1A1D1C}
.tri-l{font:500 15px var(--body);fill:#1A1D1C}
.tri-k{font:600 11.5px var(--mono);letter-spacing:.08em}

/* insights */
.ins{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.ins .card{gap:14px}
.ins .n{font:800 15px var(--mono);color:var(--fill)}
.q{border-left:3px solid var(--fill);padding:2px 0 2px 14px;font-size:14.5px;color:var(--ink)}
.q small{display:block;font:500 11px var(--mono);color:var(--muted);letter-spacing:.06em;margin-top:4px}
.stack{display:flex;height:12px;border-radius:99px;overflow:hidden;background:var(--line)}
.stack i{display:block;height:100%}
.stack-l{display:flex;justify-content:space-between;font:500 11px var(--mono);color:var(--muted);margin-top:6px}
.big{font:800 46px/1 var(--display);letter-spacing:-.03em}
.big small{display:block;font-size:14px;font-weight:500;color:var(--muted);letter-spacing:0;margin-top:6px;font-family:var(--body)}
.principles{margin-top:22px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.principles div{border-top:2px solid var(--ink);padding-top:14px;font-size:15px;color:var(--muted)}
.principles b{display:block;color:var(--ink);font:700 18px var(--display);margin-bottom:6px}

/* decisions */
.spine{border-top:1px solid var(--line)}
.dec{display:grid;grid-template-columns:90px minmax(0,.85fr) minmax(0,1.15fr);gap:40px;padding-block:52px;border-bottom:1px solid var(--line);align-items:start}
.dec > *{min-width:0}
.dec.wide > .art,.dec.wide > .txt{grid-column:2 / -1}
.dec.wide .txt ul{grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.dec .no{font:800 44px/1 var(--display);color:var(--fill);letter-spacing:-.03em;position:sticky;top:80px}
.dec .txt{display:grid;gap:12px;align-content:start}
.dec .txt p,.dec li{color:var(--muted);font-size:15.5px}
.dec ul{margin:0;padding-left:18px;display:grid;gap:6px}
.dec li b{color:var(--ink);font-weight:600}
.pill{justify-self:start;font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:99px;background:var(--soft);color:var(--signal)}
.zoom{display:block;padding:0;border:0;background:none;cursor:zoom-in;width:100%;text-align:left;border-radius:16px;overflow:hidden;box-shadow:0 0 0 1px var(--line),0 30px 60px -40px #0d3b3655}
.zoom img{width:100%}
.zh{font:500 11.5px var(--mono);color:var(--muted);margin-top:10px;display:flex;justify-content:space-between;gap:12px}
.pay{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:18px;align-items:center}
.phone{border-radius:24px;overflow:hidden;box-shadow:0 0 0 5px #fff,0 0 0 6px var(--line),0 30px 60px -30px #0d3b3666}
.fvip{background:var(--surface);border-radius:18px;box-shadow:0 0 0 1px var(--line);padding:20px;display:grid;gap:12px}
.fvip .t{font:600 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.tiers{display:flex;gap:8px;flex-wrap:wrap}
.tiers span{font:600 13px var(--mono);padding:7px 12px;border-radius:10px;background:var(--paper);box-shadow:0 0 0 1px var(--line)}
.tiers span.on{background:var(--fill);box-shadow:none}
.flow{display:grid;gap:6px;font-size:13.5px;color:var(--muted)}
.flow .ar{text-align:center}
.flow .box{border-radius:12px;padding:10px 12px;background:var(--paper);box-shadow:0 0 0 1px var(--line)}
.flow .box b{display:block;font:700 14px var(--display)}
.flow .ar{font:600 16px var(--mono);color:var(--fill)}
.seats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.seats span{border-radius:10px;padding:10px 6px;text-align:center;font:600 12px var(--mono);background:var(--soft);color:var(--signal)}
.seats span.h{background:var(--cream);color:#8A5A00}
.rules{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.rule{background:var(--surface);border-radius:18px;box-shadow:0 0 0 1px var(--line);padding:20px;display:grid;gap:6px}
.rule b{font:800 36px/1 var(--display);letter-spacing:-.03em}
.rule b small{font-size:15px;font-weight:600;color:var(--muted);letter-spacing:0;margin-left:4px}
.rule span{font-size:14px;color:var(--muted)}
.road{display:grid;gap:12px}
.lane{display:grid;grid-template-columns:110px 1fr;gap:14px;align-items:start}
.lane .ph-l{font:600 11.5px/1.4 var(--mono);letter-spacing:.08em;text-transform:uppercase;padding-top:12px}
.lane .ph-l small{display:block;font-weight:400;color:var(--muted);letter-spacing:.04em;text-transform:none;margin-top:2px}
.mods{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.mods.one{display:flex;flex-wrap:wrap;gap:8px}
.mod{border-radius:14px;padding:12px 14px;font-size:13.5px;line-height:1.4;color:var(--muted);background:var(--surface);box-shadow:0 0 0 1px var(--line)}
.mod b{display:block;color:var(--ink);font:700 15px var(--display);margin-bottom:3px}
.mods.one .mod{background:var(--fill);box-shadow:none;color:var(--ink);font:600 13px var(--body);padding:9px 14px;border-radius:99px}
.road .down{font:600 14px var(--mono);color:var(--fill);padding-left:124px}

/* stage (interaction design) */
.stage{padding:0 12px;color:var(--stage-ink)}
.stage > .wrap{max-width:1272px;background:var(--stage);border-radius:40px;padding:104px clamp(20px,6vw,100px)}
.stage .eyebrow{color:var(--fill)}
.stage .lede{color:var(--stage-muted)}
.boards{display:grid;gap:72px}
.bd{display:grid;gap:20px}
.bd-h{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px 20px;align-items:center}
.bd-h .k{width:56px;height:56px;border-radius:16px;display:grid;place-items:center;font:800 30px/1 var(--display);color:#0C110F;background:var(--fill);letter-spacing:-.02em}
.bd-h h3{font-size:clamp(22px,2.4vw,28px)}
.bd-h p{grid-column:2;color:var(--stage-muted);font-size:15.5px}
.stage .zoom{box-shadow:0 0 0 1px #34484450,0 40px 80px -40px #0008}
.stage .zh{color:var(--stage-muted)}
.callouts{display:flex;flex-wrap:wrap;gap:8px}
.callouts span{font:500 12px var(--mono);color:var(--stage-ink);background:var(--stage-2);border:1px solid #3A4E4A;border-radius:99px;padding:6px 12px}
.callouts span b{color:var(--fill);font-weight:600;margin-right:6px}
.screens{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px;align-items:start}
.screens figure{display:grid;gap:12px}
.screens .phone{box-shadow:0 0 0 5px #2E423F,0 30px 60px -30px #0008}
.screens figcaption{font-size:13.5px;color:var(--stage-muted);line-height:1.45}
.screens figcaption b{display:block;color:var(--stage-ink);font:700 15px var(--display);margin-bottom:2px}

/* results */
.res{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.5fr);gap:40px;align-items:start}
.res > *{min-width:0}
.chart-card{background:var(--surface);border-radius:24px;box-shadow:0 0 0 1px var(--line);padding:24px 24px 14px}
.chart-card h3{font-size:20px}
.chart-card .sub{color:var(--muted);font-size:14px;margin-top:6px}
.chart{width:100%;height:auto;margin-top:12px}
.side{display:grid;gap:22px}
.side div{border-top:2px solid var(--ink);padding-top:14px}
.side b{font:800 34px/1 var(--display);letter-spacing:-.03em;display:block}
.side span{font-size:14px;color:var(--muted)}
.why{margin-top:40px;display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.why span{font:600 14px var(--body);padding:10px 16px;border-radius:12px;background:var(--surface);box-shadow:0 0 0 1px var(--line)}
.why span em{font-style:normal;font:500 12px var(--mono);color:var(--signal);margin-left:8px}
.why i{font-style:normal;color:var(--muted)}

.refl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:44px}
.refl div{border-top:2px solid var(--ink);padding-top:18px;display:grid;gap:10px;align-content:start}
.refl p{color:var(--muted);font-size:15px}
.learn{margin-top:64px;font:500 clamp(22px,2.6vw,32px)/1.35 var(--display);letter-spacing:-.015em;max-width:30em}
.learn em{font-style:normal;background:linear-gradient(transparent 62%,#BDEBE4 62%)}
.next{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.next a{display:grid;gap:8px;padding:28px;border-radius:20px;background:var(--surface);box-shadow:0 0 0 1px var(--line);color:var(--ink);text-decoration:none;transition:box-shadow .2s}
.next a:hover{box-shadow:0 0 0 2px var(--fill)}
.next small{font:500 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.next b{font:700 24px var(--display)}

/* lightbox */
.lb{position:fixed;inset:0;z-index:20;background:#0B0D0CF2;display:none;overflow:auto;padding:56px 16px 24px}
.lb.on{display:block}
.lb img{max-width:none;width:min(2800px,220vw);margin-inline:auto;border-radius:8px}
.lb button{position:fixed;top:12px;right:16px;font:600 13px var(--mono);border:0;border-radius:99px;padding:9px 16px;background:#fff;color:var(--ink);cursor:pointer}
.lb .hint{position:fixed;top:18px;left:18px;font:500 12px var(--mono);color:#9AA5A1}

@media (max-width:900px){
  section{padding-block:72px}
  .hero .wrap,.map-wrap,.res{grid-template-columns:1fr}
  .meta,.nums{grid-template-columns:repeat(2,minmax(0,1fr))}
  .num{border-right:0;border-bottom:1px solid var(--line);padding-left:0!important}
  .num.hi{margin-right:0;padding-left:16px!important}
  .cards3,.ins,.principles,.refl,.next{grid-template-columns:1fr}
  .dec{grid-template-columns:1fr;gap:16px;padding-block:40px}
  .dec.wide > .art,.dec.wide > .txt{grid-column:auto}
  .dec.wide .txt ul{grid-template-columns:1fr;gap:6px}
.dec .no{position:static;font-size:32px}
  .map{min-width:640px}
  .screens{grid-template-columns:1fr 1fr}
  
  .lane{grid-template-columns:1fr}.road .down{padding-left:0}
  .goal{grid-template-columns:1fr}
  .tri-card{grid-template-columns:1fr}
  .tri{min-width:600px}
  .side{grid-template-columns:1fr 1fr}
  .chart-card{overflow-x:auto}.chart{min-width:620px}
}
@media (max-width:560px){.pay,.rules,.mods{grid-template-columns:1fr}.pay .phone{max-width:240px;margin-inline:auto}.lb img{width:260vw}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
/* design scope strip */
.scope{margin-top:20px;display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.scope .sl{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;opacity:.75;margin-right:4px}
.scope .p{font:600 12.5px var(--body);padding:6px 12px;border-radius:99px;border:1px dashed currentColor;opacity:.4}
.scope .p.on{opacity:1;border:1px solid transparent;background:var(--scope-bg);color:var(--scope-ink)}
.hero .scope{color:var(--muted);--scope-bg:var(--fill);--scope-ink:#0C110F}
</style>

<header class="bar">
  <div class="wrap"><a href="/">Serena Zhang</a><span>Case study 03 / 03</span></div>
</header>

<!-- HERO -->
<section class="hero" id="top">
  <div class="wrap">
    <div>
      <div class="eyebrow">Case study · Tencent Video · Membership</div>
      <h1>One membership, <em>a whole family</em></h1>
      <p class="lede">I designed and led China's first family account system built for elders and kids. Adult children invite their parents and children, pay for them, and look after them, turning account sharing into a product people pay for.</p>
      <div class="tags"><span class="tag">Product strategy</span><span class="tag">Account system</span><span class="tag">Pricing</span><span class="tag">Interaction design</span></div>
      <div class="scope" aria-label="My design scope: Product logic, UI / UX, Data, Monetization"><span class="sl">My design scope</span><span class="p on">Product logic</span><span class="p on">UI / UX</span><span class="p on">Data</span><span class="p on">Monetization</span></div>
      <dl class="meta">
        <div><dt>Role</dt><dd>Product lead, end-to-end design</dd></div>
        <div><dt>Partner</dt><dd>Membership team</dd></div>
        <div><dt>Users</dt><dd>Payers, elders, kids</dd></div>
        <div><dt>Scope</dt><dd>Logic, pricing, interaction design</dd></div>
      </dl>
    </div>
    <div class="fan" aria-label="Three app screens: the recommendation feed, My Family, and the pay-for-family sheet">
      <figure class="ph a"><img src="/media/family-account/s-feed.jpg" alt="Home feed with a 'Recommended by ALEX' section from a family member"></figure>
      <figure class="ph b"><img src="/media/family-account/s-family.jpg" alt="My Family page: the owner's profile, one member card with a Manage button and an invite slot"></figure>
