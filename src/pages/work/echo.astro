---
import Base from '../../layouts/Base.astro';
---
<Base title="Echo AI Companion · Serena Zhang" description="Laurier UX605 project: an AI emotional-support companion app, from research and personas to lo-fi, hi-fi and usability testing.">
<style is:global>
/* Layout: a single dark "night sky" theme that matches the product itself. Phone screens sit in rows like a storyboard; research and test data sit in plain, readable blocks between them. */
:root{
  --bg:#0E0C18; --surface:#16132A; --raise:#1E1A38; --ink:#ECEAF6; --muted:#A6A2BF; --line:#2B2746;
  --accent:#9B7DFF; --glow:#6FE3E6; --warn:#FF7A8A;
  --display:"TencentSans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --body:"TencentSans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --mono:"TencentSans","PingFang SC","Helvetica Neue",Arial,sans-serif;
  --wrap:1120px;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:400 16px/1.65 var(--body);margin:0}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media (min-width:700px){.wrap{padding-left:max(24px,env(safe-area-inset-left,0px));padding-right:max(24px,env(safe-area-inset-right,0px))}}
img{max-width:100%;display:block;height:auto}
h1,h2,h3{font-family:var(--display);font-weight:700;letter-spacing:-.02em;line-height:1.06;margin:0;text-wrap:balance}
h2{font-size:clamp(30px,4.2vw,46px)}
h3{font-size:21px;letter-spacing:-.01em}
p{margin:0;max-width:62ch}
figure{margin:0}
a{color:inherit}
:focus-visible{outline:2px solid var(--glow);outline-offset:3px}
.eyebrow{font:500 12px/1.3 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--glow)}
.lede{font-size:18px;color:var(--muted)}
.cap{font:400 12px/1.5 var(--mono);color:var(--muted)}
section{padding-block:96px}
.head{display:grid;gap:16px;margin-bottom:48px;max-width:760px}

.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:14px;font:500 13px var(--mono);color:var(--muted)}
.bar a{color:var(--ink);text-decoration:none}

/* hero */
.hero{position:relative;overflow:hidden;padding-block:72px 64px}
.hero::before{content:"";position:absolute;inset:-20% -10% auto auto;width:70%;height:120%;background:radial-gradient(closest-side,color-mix(in srgb,var(--accent) 30%,transparent),transparent 70%);pointer-events:none}
.hero .wrap{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
.hero h1{font-size:clamp(28px,3.4vw,40px);font-weight:800;letter-spacing:-.035em;margin-block:20px 22px}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--accent),var(--glow));-webkit-background-clip:text;background-clip:text;color:transparent}
.meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 24px;margin-top:34px;padding-top:22px;border-top:1px solid var(--line)}
.meta dt{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.meta dd{margin:5px 0 0;font-weight:500;font-size:14.5px;line-height:1.45}
.scope{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.scope span{font:500 11.5px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:6px 11px;border-radius:99px;border:1px solid var(--line);color:var(--muted)}
.scope span.on{border-color:color-mix(in srgb,var(--accent) 60%,transparent);color:var(--ink);background:color-mix(in srgb,var(--accent) 18%,transparent)}
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:center}
.trio .ph:nth-child(2){transform:translateY(-26px)}

/* phone */
.ph{border-radius:22px;overflow:hidden;background:#000;box-shadow:0 0 0 1px var(--line),0 30px 60px -30px #000}
.ph img{width:100%}
.phs{display:grid;gap:16px;grid-template-columns:repeat(4,minmax(0,1fr))}
.phs figure{display:grid;gap:10px;align-content:start}
.phs figcaption{font:400 12px/1.45 var(--mono);color:var(--muted)}
.phs figcaption b{display:block;color:var(--ink);font:600 13px var(--body);margin-bottom:2px}

/* numbers */
.nums{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid var(--line)}
.num{padding:28px 20px 28px 0;display:grid;gap:8px;align-content:start}
.num + .num{padding-left:24px;border-left:1px solid var(--line)}
.num b{font:800 clamp(28px,3.4vw,40px)/.95 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.num span{color:var(--muted);font-size:14px;line-height:1.45;max-width:24ch}

/* personas */
.personas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.pc{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:26px;display:grid;gap:16px;align-content:start}
.pc .top{display:flex;gap:14px;align-items:center}
.pc .av{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font:700 20px var(--display);background:linear-gradient(135deg,var(--accent),var(--glow));color:var(--bg);flex:none}
.pc .who{font:400 12.5px/1.5 var(--mono);color:var(--muted)}
.pc blockquote{margin:0;padding:12px 14px;border-radius:12px;background:color-mix(in srgb,var(--glow) 14%,transparent);color:var(--ink);font-size:15px;line-height:1.5}
.pc dl{display:grid;grid-template-columns:auto minmax(0,1fr);gap:6px 14px;margin:0;font-size:14px}
.pc dt{font:500 11px/1.9 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.pc dd{margin:0}
.more-p{margin-top:16px}

/* process strips */
.flows2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:start}
.flows2 figure{margin:0;display:grid;gap:12px;min-width:0}
.fl-lab{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.fl-lab b{font:700 18px var(--display)}
.fl-lab span{font:400 12.5px/1.5 var(--mono);color:var(--muted)}
.fl-img{display:block;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#0d0b14;cursor:zoom-in;transition:border-color .2s}
.fl-img:hover{border-color:#8a7cff}
.fl-img img{display:block;width:100%;height:auto}
@media (max-width:760px){.flows2{grid-template-columns:1fr}}
.strips{display:grid;gap:22px}
.strip{display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px;align-items:center;padding-block:18px;border-top:1px solid var(--line)}
.strip .lab{display:grid;gap:6px}
.strip .lab b{font:700 18px var(--display)}
.strip .lab span{font:400 12.5px/1.5 var(--mono);color:var(--muted)}
.strip .img{border-radius:14px;overflow:hidden;background:#808080;max-width:660px;width:100%}

/* visual direction */
.vis{display:grid;grid-template-columns:1.1fr .9fr .9fr;gap:14px}
.vis figure{border-radius:18px;overflow:hidden;position:relative}
.vis img{width:100%;height:100%;object-fit:cover;aspect-ratio:4/5}
.vis figcaption{position:absolute;left:12px;bottom:12px;right:12px;font:500 11px var(--mono);letter-spacing:.06em;color:#fff;text-shadow:0 1px 8px #000}
.ds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:14px}
.ds figure{border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.note{margin-top:14px}

/* flows */
.flow{display:grid;gap:18px;padding-block:34px;border-top:1px solid var(--line)}
.flow .fh{display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap}
.flow .fh p{color:var(--muted);font-size:15px}

/* test */
.method{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-bottom:34px}
.method div{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px;display:grid;gap:6px;align-content:start}
.method b{font:600 15px var(--body)}
.method span{font-size:14px;color:var(--muted)}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:24px;display:grid;gap:14px}
.chart .row{display:grid;grid-template-columns:200px minmax(0,1fr) 120px;gap:16px;align-items:center;font-size:14px}
.chart .track{height:14px;border-radius:99px;background:var(--raise);position:relative;overflow:hidden}
.chart .fill{position:absolute;inset:0 auto 0 0;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--glow))}
.chart .fill.hot{background:linear-gradient(90deg,var(--accent),var(--warn))}
.chart .v{font:500 13px var(--mono);color:var(--muted);font-variant-numeric:tabular-nums;text-align:right}
.chart .v b{color:var(--ink);font-weight:500}
.chart .axis{display:grid;grid-template-columns:200px minmax(0,1fr) 120px;gap:16px;font:400 11px var(--mono);color:var(--muted)}
.chart .axis div{display:flex;justify-content:space-between}

/* findings */
.find{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:40px;align-items:center;padding-block:40px;border-top:1px solid var(--line)}
.find .t{display:grid;gap:14px}
.find .t p{color:var(--muted)}
.find .q{border-left:3px solid var(--glow);padding-left:14px;color:var(--ink);font-size:15px}
.tag{justify-self:start;font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:99px;background:color-mix(in srgb,var(--warn) 20%,transparent);color:var(--warn)}
.ba{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.ba figure{display:grid;gap:10px}
.ba .k{font:600 11px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.ba .after .k{color:var(--glow)}
.ba .ph{position:relative}
.ba .hl{position:absolute;border:2px solid var(--warn);border-radius:10px}
.ba .after .hl{border-color:var(--glow)}
.fixes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.fix{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px;display:grid;gap:10px;align-content:start}
.fix p{color:var(--muted);font-size:15px}
.fix .swap{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font:500 13px var(--mono)}
.fix .swap s{color:var(--muted)}
.fix .swap b{color:var(--glow);font-weight:500}

.learn{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.learn div{display:grid;gap:8px;align-content:start;border-top:2px solid var(--accent);padding-top:16px}
.learn p{color:var(--muted);font-size:15px}

.next{border-top:1px solid var(--line);padding-block:48px}
.next .wrap{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.next a{display:grid;gap:6px;text-decoration:none;padding:22px;border:1px solid var(--line);border-radius:18px;background:var(--surface)}
.next a:hover{border-color:var(--accent)}
.next small{font:500 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.next b{font:700 20px var(--display)}
footer{padding-block:28px 48px;color:var(--muted);font:400 12px var(--mono)}

@media (max-width:900px){
  .hero .wrap,.find{grid-template-columns:1fr}
  .phs{grid-template-columns:repeat(2,minmax(0,1fr))}
  .nums{grid-template-columns:repeat(2,minmax(0,1fr))}
  .num:nth-child(3){padding-left:0;border-left:0}
  .num:nth-child(n+3){border-top:1px solid var(--line)}
  .personas,.method,.learn,.fixes,.ds{grid-template-columns:1fr}
  .vis{grid-template-columns:1fr 1fr}
  .vis figure:first-child{grid-column:1/-1}
  .vis figure:first-child img{aspect-ratio:16/10}
  .strip{grid-template-columns:1fr;gap:12px}
  .chart .row,.chart .axis{grid-template-columns:110px minmax(0,1fr) 92px;gap:10px;font-size:13px}
  .next .wrap{grid-template-columns:1fr}
  section{padding-block:72px}
}
@media (max-width:480px){.meta{grid-template-columns:1fr}.trio{gap:8px}}
@media (prefers-reduced-motion:no-preference){.ph img{transition:transform .5s ease}.phs figure:hover .ph img{transform:scale(1.02)}}

/* site-wide type: TencentSans, heading sizes matched to the homepage */
h1{font-size:clamp(32px,4vw,46px)!important;font-weight:700!important;letter-spacing:-.015em!important;line-height:1.15!important}
h2{font-size:clamp(24px,2.6vw,30px)!important;font-weight:700!important;letter-spacing:-.01em!important;line-height:1.15!important}
h3{font-size:18px!important;letter-spacing:0!important;line-height:1.25!important}
</style>

<header class="bar"><div class="wrap"><a href="/">Serena Zhang</a><span>Laurier work · 01 / 02</span></div></header>

<main id="top">
<section class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow">UX605 Prototyping · Wilfrid Laurier University · 2026</div>
      <h1>Echo: an AI companion that <em>listens first</em></h1>
      <p class="lede">A mobile app for everyday emotional support. Users create their own AI companion, talk to it by text or voice, meet it in AR and keep a mood diary. We took it from research to a tested high-fidelity prototype.</p>
      <div class="scope"><span class="on">Research</span><span class="on">Personas</span><span class="on">Lo-fi to hi-fi</span><span class="on">Visual design</span><span class="on">Usability testing</span></div>
      <dl class="meta">
        <div><dt>Type</dt><dd>Course project, high-fidelity prototype</dd></div>
        <div><dt>Team</dt><dd>4 designers: Carol Chen, Qiaohui Xu, Si Zhang, Aileen Zhou</dd></div>
        <div><dt>Tools</dt><dd>Figma, Figma Make, Zoom, Google Sheets, AI tools for concept art and analysis</dd></div>
        <div><dt>Scope</dt><dd>5 core flows, about 20 key screens</dd></div>
      </dl>
    </div>
    <div class="trio">
      <div class="ph"><img src="/media/echo/p-splash.jpg" alt="Echo splash screen: the ECHO wordmark on a dark purple gradient with Log in and Sign up buttons"></div>
      <div class="ph"><img src="/media/echo/p-chat.jpg" alt="Main chat screen with the 3D companion waving and the message bubble Hi! How is your day?"></div>
      <div class="ph"><img src="/media/echo/p-diary.jpg" alt="Mood overview with a monthly calendar, sentiment bar and mood breakdown"></div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="nums">
    <div class="num"><b>4</b><span>personas built from interviews and secondary research</span></div>
    <div class="num"><b>5</b><span>core tasks tested with first-time users</span></div>
    <div class="num"><b>19/20</b><span>task runs fully completed (1 partial)</span></div>
    <div class="num"><b>91.7</b><span>average UMUX-Lite score out of 100</span></div>
  </div>
</div>

<!-- RESEARCH -->
<section id="research">
  <div class="wrap">
    <div class="head">
      <div class="eyebrow">Research</div>
      <h2>Who needs a companion, and what makes them trust one</h2>
      <p class="lede">We started with secondary research on emotional-support apps and accessibility, then ran interviews and synthesized them with affinity mapping and a journey map. Four personas came out of it. Two are shown here.</p>
    </div>
    <div class="personas">
      <article class="pc">
        <div class="top"><div class="av" aria-hidden="true">A</div><div><h3>Andy</h3><div class="who">21 · Calgary · heavy online gamer</div></div></div>
        <blockquote>“It's probably because of my lack of confidence in describing my emotions and feelings. Like the biggest struggle from getting emotional support.”</blockquote>
        <dl>
          <dt>Needs</dt><dd>Passive companionship, social mediation, validation during conflict</dd>
          <dt>Context</dt><dd>His social life lives in Discord and in-game voice. Daily social needs are met online, deeper support is missing.</dd>
          <dt>Design cue</dt><dd>Lower the effort of expressing feelings: voice input and one-tap mood icons.</dd>
        </dl>
      </article>
      <article class="pc">
        <div class="top"><div class="av" aria-hidden="true">D</div><div><h3>David</h3><div class="who">25 · Toronto · night owl, pragmatic AI user</div></div></div>
        <blockquote>“If I feel like it's an AI, chatting with it feels very weird… It should just provide emotional comfort, not specific advice.”</blockquote>
        <dl>
          <dt>Needs</dt><dd>Simple stress relief, non-prescriptive comfort, efficiency</dd>
          <dt>Context</dt><dd>Uses AI tools for work every day but keeps them apart from emotional life. Skeptical of robotic responses.</dd>
          <dt>Design cue</dt><dd>Comfort before features, and a companion that feels human enough to talk to.</dd>
        </dl>
      </article>
    </div>
    <p class="cap more-p">The other two personas are Margaret and Mia. Interviewee photos are left out to protect their privacy.</p>
  </div>
</section>

<!-- PROCESS -->
<section id="process" style="padding-top:0">
  <div class="wrap">
    <div class="head">
      <div class="eyebrow">From wireframe to prototype</div>
      <h2>Low-fi to mid-fi to hi-fi</h2>
      <p class="lede">We mapped every flow in grey boxes first, tested the logic, then moved to dark mid-fi screens with the companion in place before polishing the visuals.</p>
    </div>
    <div class="flows2">
      <figure><div class="fl-lab"><b>Lo-fi</b><span>Grey wireframes · every flow and branch</span></div><a class="fl-img" href="/media/echo/flow-lofi-full.jpg" target="_blank" rel="noopener"><img src="/media/echo/flow-lofi.jpg" alt="Lo-fi user flow in grey wireframes: welcome, log in, Google log in and sign up, then Quick Create and Advanced customization for name, personality, memory, art style, features, appearance and voice, ending in Your companion is ready" loading="lazy"></a></figure>
      <figure><div class="fl-lab"><b>Mid-fi</b><span>Dark screens · the companion in place</span></div><a class="fl-img" href="/media/echo/flow-midfi-full.jpg" target="_blank" rel="noopener"><img src="/media/echo/flow-midfi.jpg" alt="Mid-fi user flow on dark screens with the glowing companion: 2D and AR chat modes, voice, keyboard and mood input, AR loading and low-light errors, and the daily tarot flow" loading="lazy"></a></figure>
    </div>
    <p class="cap note">Click either flow to open it full size.</p>
  </div>
</section>

<!-- VISUAL -->
<section id="visual" style="padding-top:0">
  <div class="wrap">
    <div class="head">
      <div class="eyebrow">Visual direction</div>
      <h2>A night sky, a soft glow and a companion who feels present</h2>
      <p class="lede">The look had to feel calm late at night, not clinical: a deep violet night palette with aurora highlights, and a soft, glowing 3D character so the companion feels warm rather than robotic.</p>
    </div>
    <div class="vis">
      <figure><img src="/media/echo/cover.jpg" alt="Concept image: an older woman on a sofa smiling at her phone while a glowing companion stands beside her"><figcaption>Use scene · companion at home</figcaption></figure>
      <figure><img src="/media/echo/window.jpg" alt="The companion touching a window that looks out on misty mountains"><figcaption>AR mode concept</figcaption></figure>
      <figure><img src="/media/echo/mist.jpg" alt="The companion seen from behind, looking at a sunrise over mountains"><figcaption>Mood · calm</figcaption></figure>
    </div>
    <p class="cap note">Character and scene concepts were generated with AI tools, then selected and placed into the interface by the team.</p>
    <div class="ds">
      <figure><img src="/media/echo/ds4.jpg" alt="Design system page: color scales in violet, grey, green and red, Roboto type scale and an icon set"></figure>
      <figure><img src="/media/echo/ds5.jpg" alt="Design system page: buttons, inputs, cards, avatars, toggles and accessibility settings"></figure>
    </div>
    <p class="cap note">Design system: color scales, Roboto type scale, a 60-icon set, components, and accessibility settings for text size, theme, voice output and multimodal input.</p>
  </div>
</section>

<!-- HI-FI -->
<section id="hifi" style="padding-top:0">
  <div class="wrap">
    <div class="head">
      <div class="eyebrow">High-fidelity prototype</div>
      <h2>Five flows, one calm voice</h2>
    </div>

    <div class="flow">
      <div class="fh"><h3>Create a companion</h3><p>Quick Create asks 3 questions. Advanced lets users shape every detail.</p></div>
      <div class="phs">
        <figure><div class="ph"><img src="/media/echo/p-create.jpg" alt="How would you like to create your companion? Quick Create or Advanced Customization"></div><figcaption><b>Choose a path</b>About 2 min or 5 to 7 min</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-need.jpg" alt="What do you need? screen with a voice button and the reply I've been feeling lonely since moving"></div><figcaption><b>Say what you need</b>Voice first, typing optional</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-forming.jpg" alt="Creating your companion loading screen with a glowing orb"></div><figcaption><b>Companion forming</b>Feedback while it builds</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-meet.jpg" alt="Meet Echo card with style Casual, voice Warm and Sweet, Start Conversation button"></div><figcaption><b>Meet Echo</b>Review, then start talking</figcaption></figure>
      </div>
    </div>

    <div class="flow">
      <div class="fh"><h3>Talk it through</h3><p>Text, voice or a mood icon, for moments when words are hard.</p></div>
      <div class="phs">
        <figure><div class="ph"><img src="/media/echo/p-keys.jpg" alt="Chat with keyboard open"></div><figcaption><b>Type</b>Message stays above the keyboard</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-voice.jpg" alt="Voice input with a waveform around the microphone"></div><figcaption><b>Speak</b>Hold to talk</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-mood.jpg" alt="Row of emoji mood icons floating above the input"></div><figcaption><b>Share a mood</b>One tap instead of a sentence</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-empathy.jpg" alt="Companion replies Your feelings are valid. I'm here to support you through this."></div><figcaption><b>Feel heard</b>Empathy before suggestions</figcaption></figure>
      </div>
    </div>

    <div class="flow">
      <div class="fh"><h3>AR, diary and personal settings</h3><p>The companion steps into the room, the diary shows the month, settings adapt the app.</p></div>
      <div class="phs">
        <figure><div class="ph"><img src="/media/echo/p-ar.jpg" alt="AR mode: the companion standing in a real living room"></div><figcaption><b>AR mode</b>Companion in your space</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-ar-window.jpg" alt="Companion pointing at a window with mountains, sharing the view"></div><figcaption><b>Share a view</b>Send a photo, get a reaction</figcaption></figure>
        <figure><div class="ph"><img src="/media/echo/p-settings.jpg" alt="Settings screen with account, app language, text size and theme"></div><figcaption><b>Settings</b>Text size, theme, language</figcaption></figure>
